<mxCell id="c2006" value="&lt;b&gt;clients&lt;/b&gt;&lt;br&gt;&lt;i style=&#x27;font-size:10px&#x27;&gt;[Go]&lt;/i&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Client (customer) CRUD&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#0b3d6b;fontColor=#0b3d6b;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="230" width="330" height="130" as="geometry"/></mxCell>
<mxCell id="c2007" value="&lt;b&gt;assets&lt;/b&gt;&lt;br&gt;&lt;i style=&#x27;font-size:10px&#x27;&gt;[Go]&lt;/i&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Asset CRUD; registering one starts its first Project&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#0b3d6b;fontColor=#0b3d6b;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="230" width="330" height="130" as="geometry"/></mxCell>
