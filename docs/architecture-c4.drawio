<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2001" value="&lt;b&gt;Conservator / Admin&lt;/b&gt;&lt;br&gt;&lt;i style=&#x27;font-size:10px&#x27;&gt;[Web browser]&lt;/i&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Signs in, records condition/treatment, drafts and exports reports&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#0b3d6b;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="180" height="110" as="geometry"/></mxCell>
<mxCell id="c2002" value="Studio — single Go binary, one SQLite file, local disk (self-hosted, no external services)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="280" y="20" width="1500" height="1040" as="geometry"/></mxCell>
<mxCell id="c2003" value="&lt;b&gt;Server-rendered UI&lt;/b&gt;&lt;br&gt;&lt;i style=&#x27;font-size:10px&#x27;&gt;[templ views + static/js islands]&lt;/i&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Full HTML per request; small vanilla-JS islands for kanban drag-drop, gallery reorder, list search/filter — no SPA, no bundler&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0b3d6b;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="70" width="1420" height="90" as="geometry"/></mxCell>
<mxCell id="c2004" value="internal/ modules — one Go package per feature, mounted on a shared net/http.ServeMux" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="320" y="190" width="1420" height="620" as="geometry"/></mxCell>
