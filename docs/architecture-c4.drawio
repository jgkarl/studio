<mxCell id="c2010" value="&lt;b&gt;treatments&lt;/b&gt;&lt;br&gt;&lt;i style=&#x27;font-size:10px&#x27;&gt;[Go]&lt;/i&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Conservation work performed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#0b3d6b;fontColor=#0b3d6b;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="380" width="330" height="130" as="geometry"/></mxCell>
<mxCell id="c2011" value="&lt;b&gt;reporter&lt;/b&gt;&lt;br&gt;&lt;i style=&#x27;font-size:10px&#x27;&gt;[Go (routes as /reports)]&lt;/i&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Report sections, image gallery (order/columns/stretch), layout + export options&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#0b3d6b;fontColor=#0b3d6b;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="380" width="330" height="130" as="geometry"/></mxCell>
