# Copy to all.yml (gitignored) and adjust. Non-secret settings live here in plain text; secret
# values live in vault.yml (see vault.yml.example) and are only referenced here by name so this
# file stays safe to read/diff without decrypting anything.

# --- Non-secret settings ------------------------------------------------------------------------

# Domain the app is reachable at. Leave blank to skip installing/configuring Caddy entirely (e.g.
# you're fronting it with something else, or testing without DNS yet) - the app still runs on
# studio_port, just with no reverse proxy/TLS in front of it.
studio_domain: "yourdomain.com"

studio_port: 3000

# "latest" tracks whatever release.yml most recently published. Pin to an exact tag (e.g.
# "v1.2.3") to control exactly what update.yml deploys instead.
studio_release_version: "latest"

# owner/repo on GitHub that release.yml publishes to.
studio_github_repo: "jgkarl/studio-go"

# --- Secrets (values live in vault.yml, only referenced by name here) --------------------------

studio_auth_secret: "{{ vault_studio_auth_secret }}"
studio_seed_example_data: "{{ vault_studio_seed_example_data }}"
studio_app_url: "{{ vault_studio_app_url }}"
studio_bootstrap_admin_name: "{{ vault_studio_bootstrap_admin_name }}"
studio_bootstrap_admin_email: "{{ vault_studio_bootstrap_admin_email }}"
studio_bootstrap_admin_password: "{{ vault_studio_bootstrap_admin_password }}"
studio_smtp_host: "{{ vault_studio_smtp_host }}"
studio_smtp_port: "{{ vault_studio_smtp_port }}"
studio_smtp_user: "{{ vault_studio_smtp_user }}"
studio_smtp_pass: "{{ vault_studio_smtp_pass }}"
studio_smtp_from: "{{ vault_studio_smtp_from }}"
