# Copy to all.yml (gitignored) and adjust. Non-secret settings live here in plain text; secret
# values live in vault.yml (see vault.yml.example) and are only referenced here by name so this
# file stays safe to read/diff without decrypting anything.

# --- Non-secret settings ------------------------------------------------------------------------

# Domain the app is reachable at. Leave blank to skip installing/configuring Caddy entirely (e.g.
# you're fronting it with something else, or testing without DNS yet) - the app still runs on
# stuudio_port, just with no reverse proxy/TLS in front of it.
stuudio_domain: "yourdomain.com"

stuudio_port: 3000

# "latest" tracks whatever release.yml most recently published. Pin to an exact tag (e.g.
# "v1.2.3") to control exactly what update.yml deploys instead.
stuudio_release_version: "latest"

# owner/repo on GitHub that release.yml publishes to.
stuudio_github_repo: "jgkarl/studio-go"

# --- Secrets (values live in vault.yml, only referenced by name here) --------------------------

stuudio_auth_secret: "{{ vault_stuudio_auth_secret }}"
stuudio_seed_example_data: "{{ vault_stuudio_seed_example_data }}"
stuudio_app_url: "{{ vault_stuudio_app_url }}"
stuudio_bootstrap_admin_name: "{{ vault_stuudio_bootstrap_admin_name }}"
stuudio_bootstrap_admin_email: "{{ vault_stuudio_bootstrap_admin_email }}"
stuudio_bootstrap_admin_password: "{{ vault_stuudio_bootstrap_admin_password }}"
stuudio_smtp_host: "{{ vault_stuudio_smtp_host }}"
stuudio_smtp_port: "{{ vault_stuudio_smtp_port }}"
stuudio_smtp_user: "{{ vault_stuudio_smtp_user }}"
stuudio_smtp_pass: "{{ vault_stuudio_smtp_pass }}"
stuudio_smtp_from: "{{ vault_stuudio_smtp_from }}"
