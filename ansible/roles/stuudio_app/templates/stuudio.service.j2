# Managed by Ansible (ansible/roles/stuudio_app/templates/stuudio.service.j2).
[Unit]
Description=Stuudio (conservation studio management)
After=network.target

[Service]
Type=simple
User={{ stuudio_system_user }}
Group={{ stuudio_system_user }}
WorkingDirectory={{ stuudio_home }}
EnvironmentFile={{ stuudio_home }}/.env
ExecStart={{ stuudio_home }}/server
Restart=on-failure
RestartSec=2

# Basic hardening - the binary is fully self-contained (migrations/static assets embedded, see
# db/migrations/embed.go and static/embed.go), so it only ever needs to write to data/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths={{ stuudio_home }}/data

[Install]
WantedBy=multi-user.target
