package reporter

import "studio/internal/media"
import "studio/internal/web"

templ ListPage(c web.Chrome, rows []ListRow) {
	@web.AppLayout("Reports", c, listBody(rows))
}

templ listBody(rows []ListRow) {
	@web.PageHeader("Reports", "Conservation write-ups.", newReportLink())
	@web.Card() {
		if len(rows) == 0 {
			<p class="empty-state">No reports yet.</p>
		}
		<ul class="entity-list">
			for _, row := range rows {
				<li class="entity-list-row">
					<div>
						<a href={ templ.URL("/reports/" + row.ID) } class="entity-list-name">{ row.Title }</a>
						<div class="page-subtitle">
							if row.AssetTitle.Valid {
								{ row.AssetTitle.String }
							} else {
								{ row.AssetReferenceCode }
							}
							if row.AuthorName.Valid {
								· { row.AuthorName.String }
							}
						</div>
					</div>
					if row.Status == "final" {
						<span class="badge badge-green">Final</span>
					} else {
						<span class="badge badge-amber">Draft</span>
					}
				</li>
			}
		</ul>
	}
}

templ newReportLink() {
	<a class="btn btn-primary" href="/reports/new">
		<img src="/static/icons/add.svg" width="16" height="16" alt="" class="icon icon-invert"/>
		New report
	</a>
}

templ NewPage(c web.Chrome, assets []AssetOption, projects []ProjectOption, preselectedAssetID, preselectedProjectID string) {
	@web.AppLayout("New report", c, newBody(assets, projects, preselectedAssetID, preselectedProjectID))
}

templ newBody(assets []AssetOption, projects []ProjectOption, preselectedAssetID, preselectedProjectID string) {
	@web.PageHeader("New report", "", templ.NopComponent)
	@web.Card() {
		<form method="post" action="/reports" class="form-grid">
			@web.Field("Asset", "pre-fills condition findings and treatment performed from this asset's history") {
				<select class="input" name="assetId" required>
					<option value="" disabled selected?={ preselectedAssetID == "" }>Select an asset…</option>
					for _, a := range assets {
						<option value={ a.ID } selected?={ a.ID == preselectedAssetID }>{ assetOptionLabel(a) }</option>
					}
				</select>
			}
			@web.Field("Project", "optional — links this report to a project") {
				<select class="input" name="projectId">
					<option value="" selected?={ preselectedProjectID == "" }>No project</option>
					for _, p := range projects {
						<option value={ p.ID } selected?={ p.ID == preselectedProjectID }>{ p.Title }</option>
					}
				</select>
			}
			@web.Field("Title", "") {
				<input class="input" name="title" required placeholder="e.g. Conservation Report — 2026-014"/>
			}
			<button type="submit" class="btn btn-primary">
				<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon icon-invert"/>
				Create report
			</button>
		</form>
	}
}

func assetOptionLabel(a AssetOption) string {
	name := a.ReferenceCode
	if a.Title.Valid && a.Title.String != "" {
		name = a.Title.String
	}
	return name + " — " + a.ClientName
}

templ DetailPage(c web.Chrome, report Report, attachments []media.ReferenceWithMedia) {
	@web.AppLayout(report.Title, c, detailBody(report, attachments))
}

templ detailBody(report Report, attachments []media.ReferenceWithMedia) {
	@web.PageHeader(report.Title, "", templ.NopComponent)
	<div class="row-actions" style="margin-bottom: 1rem;">
		@web.ExportLinks("report", report.ID)
		if report.Status == "final" {
			<span class="badge badge-green">Final</span>
			<form method="post" action={ templ.URL("/reports/" + report.ID + "/status") }>
				<input type="hidden" name="status" value="draft"/>
				<button type="submit" class="btn btn-secondary">
					<img src="/static/icons/edit.svg" width="14" height="14" alt="" class="icon"/>
					Revert draft
				</button>
			</form>
		} else {
			<span class="badge badge-amber">Draft</span>
			<form method="post" action={ templ.URL("/reports/" + report.ID + "/status") }>
				<input type="hidden" name="status" value="final"/>
				<button type="submit" class="btn btn-secondary">
					<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon"/>
					Mark final
				</button>
			</form>
		}
	</div>

	<div class="report-layout">
		<div class="report-layout-main">
			@web.Card() {
				<form method="post" action={ templ.URL("/reports/" + report.ID + "/sections") } class="form-grid">
					@web.Field("Summary", "") {
						<textarea class="input" name="summary" rows="3" readonly?={ report.Status == "final" }>{ report.Summary.String }</textarea>
					}
					@web.Field("Condition findings", "") {
						<textarea class="input" name="conditionFindings" rows="4" readonly?={ report.Status == "final" }>{ report.ConditionFindings.String }</textarea>
					}
					@web.Field("Treatment performed", "") {
						<textarea class="input" name="treatmentPerformed" rows="4" readonly?={ report.Status == "final" }>{ report.TreatmentPerformed.String }</textarea>
					}
					@web.Field("Materials used", "") {
						<textarea class="input" name="materialsUsed" rows="3" readonly?={ report.Status == "final" }>{ report.MaterialsUsed.String }</textarea>
					}
					@web.Field("Recommendations", "") {
						<textarea class="input" name="recommendations" rows="3" readonly?={ report.Status == "final" }>{ report.Recommendations.String }</textarea>
					}
					if report.Status != "final" {
						<button type="submit" class="btn btn-primary">
							<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon icon-invert"/>
							Save sections
						</button>
					}
				</form>
			}

			@web.Card() {
				<h2 class="dashboard-heading">Attachments <span class="page-subtitle">(images/video)</span></h2>
				@media.MediaGrid(attachments)
				if report.Status != "final" {
					<form method="post" action={ templ.URL("/reports/" + report.ID + "/attachments") } enctype="multipart/form-data" class="row-actions form-section">
						<input type="file" name="photos" multiple accept="image/*,video/*" capture="environment"/>
						<button type="submit" class="btn btn-secondary">
							<img src="/static/icons/add.svg" width="14" height="14" alt="" class="icon"/>
							Upload
						</button>
					</form>
				}
			}
		</div>

		<div class="report-layout-sidebar">
			@web.Card() {
				<h2 class="dashboard-heading">Customize layout</h2>
				<form method="post" action={ templ.URL("/reports/" + report.ID + "/layout") } class="form-grid">
					@web.Field("Layout style", "") {
						<select class="input" name="layoutStyle">
							for _, style := range []string{"standard", "compact", "gallery"} {
								<option value={ style } selected?={ style == report.LayoutStyle }>{ layoutStyleLabel(style) }</option>
							}
						</select>
					}
					if len(attachments) > 0 {
						@web.Field("Cover image", "") {
							<select class="input" name="coverMediaId">
								<option value="">None</option>
								for _, ref := range attachments {
									<option value={ ref.MediaID } selected?={ report.CoverMediaID.Valid && report.CoverMediaID.String == ref.MediaID }>{ ref.MediaID }</option>
								}
							</select>
						}
					}
					<div class="checkbox-grid">
						<label class="checkbox-field">
							<input type="checkbox" name="showCover" checked?={ report.ShowCover }/>
							Cover
						</label>
						<label class="checkbox-field">
							<input type="checkbox" name="showSummary" checked?={ report.ShowSummary }/>
							Summary
						</label>
						<label class="checkbox-field">
							<input type="checkbox" name="showCondition" checked?={ report.ShowCondition }/>
							Condition findings
						</label>
						<label class="checkbox-field">
							<input type="checkbox" name="showTreatment" checked?={ report.ShowTreatment }/>
							Treatment performed
						</label>
						<label class="checkbox-field">
							<input type="checkbox" name="showMaterials" checked?={ report.ShowMaterials }/>
							Materials used
						</label>
						<label class="checkbox-field">
							<input type="checkbox" name="showRecommendations" checked?={ report.ShowRecommendations }/>
							Recommendations
						</label>
					</div>
					<button type="submit" class="btn btn-secondary">
						<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon"/>
						Save layout
					</button>
				</form>
			}
		</div>
	</div>
}

func layoutStyleLabel(style string) string {
	switch style {
	case "compact":
		return "Compact"
	case "gallery":
		return "Gallery"
	default:
		return "Standard"
	}
}
