package reporter

import (
	"database/sql"

	"studio/internal/assessments"
	"studio/internal/treatments"
	"studio/internal/web"
)

templ ListPage(c web.Chrome, rows []ListRow) {
	@web.AppLayout("Reports", c, listBody(rows))
}

templ listBody(rows []ListRow) {
	@web.PageHeader("Reports", "Conservation write-ups.", web.NewActionLink("/reports/new", "New report"))
	<div data-el-root>
		<div class="list-toolbar">
			@web.EntityListSearchInput("Search by title, asset, author…")
			@web.EntityListFilterSelect("status", "All statuses", []web.FilterOption{{Value: "draft", Label: "Draft"}, {Value: "final", Label: "Final"}})
			@web.EntityListGroupBySelect([]web.FilterOption{
				{Value: "asset", Label: "Asset"},
				{Value: "client", Label: "Client"},
				{Value: "status", Label: "Status"},
			})
			<!-- Every row (removed or not) is always rendered - see ListIncludingRemoved - this chip
			     just defaults to filtering removed ones back out client-side, same mechanism
			     static/js/entity-list-filter.js already uses for every other filter here, just with
			     "Active" (not "All") preselected as its own real option instead of the usual blank one. -->
			<label class="filter-chip">
				@web.Icon("filter_alt", 14)
				<select class="filter-chip-select" data-el-filter="removed">
					<option value="0" selected>Active</option>
					<option value="">All</option>
					<option value="1">Removed</option>
				</select>
			</label>
		</div>
		if len(rows) == 0 {
			<p class="empty-state">No reports yet.</p>
		}
		<ul class="entity-list" data-el-list>
			for _, row := range rows {
				<li
					data-el-row
					data-el-search={ reportSearchHaystack(row) }
					data-el-status={ row.Status }
					data-el-removed={ removedFilterValue(row.Removed) }
					data-el-group-asset={ assetLabel(row.AssetTitle, row.AssetReferenceCode) }
					data-el-group-client={ row.ClientName }
					data-el-group-status={ statusLabel(row.Status) }
				>
					<a href={ templ.URL("/reports/" + row.ID) } class="entity-list-row">
						<div>
							<span class="entity-list-name">{ row.Title }</span>
							<div class="page-subtitle">
								if row.AssetTitle.Valid {
									{ row.AssetTitle.String }
								} else {
									{ row.AssetReferenceCode }
								}
								if row.AuthorName.Valid {
									· { row.AuthorName.String }
								}
							</div>
						</div>
						<div class="row-actions">
							if row.Removed {
								<span class="badge badge-red">Removed</span>
							}
							if row.Status == "final" {
								<span class="badge badge-green tag-chip" data-el-tag-filter="status" data-el-tag-value={ row.Status } role="button" tabindex="0">Final</span>
							} else {
								<span class="badge badge-amber tag-chip" data-el-tag-filter="status" data-el-tag-value={ row.Status } role="button" tabindex="0">Draft</span>
							}
						</div>
						<span class="material-symbols-outlined icon entity-list-chevron" style="font-size:16px" aria-hidden="true">chevron_right</span>
					</a>
				</li>
			}
		</ul>
	</div>
	<script src="/static/js/entity-list-filter.js" defer></script>
}

func removedFilterValue(removed bool) string {
	if removed {
		return "1"
	}
	return "0"
}

func assetLabel(title sql.NullString, referenceCode string) string {
	if title.Valid && title.String != "" {
		return title.String
	}
	return referenceCode
}

// statusLabel is the "Group by Status" group header text for a report row - mirrors the
// Final/Draft badge label the row itself already shows, rather than the raw "final"/"draft" code.
func statusLabel(status string) string {
	if status == "final" {
		return "Final"
	}
	return "Draft"
}

func reportSearchHaystack(row ListRow) string {
	author := ""
	if row.AuthorName.Valid {
		author = row.AuthorName.String
	}
	return row.Title + " " + assetLabel(row.AssetTitle, row.AssetReferenceCode) + " " + row.ClientName + " " + author
}

templ NewPage(c web.Chrome, projects []ProjectOption, preselectedProjectID string) {
	@web.AppLayout("New report", c, newBody(projects, preselectedProjectID))
}

templ newBody(projects []ProjectOption, preselectedProjectID string) {
	@web.PageHeader("New report", "", templ.NopComponent)
	@web.Card() {
		if len(projects) == 0 {
			<p class="empty-state">No projects yet — <a href="/projects/new">start one</a> first.</p>
		} else {
			<form method="post" action="/reports" class="form-grid">
				@web.Field("Project", "pre-fills condition findings and treatment performed from this project's records") {
					<select class="input" name="projectId" required>
						<option value="" disabled selected?={ preselectedProjectID == "" }>Select a project…</option>
						for _, p := range projects {
							<option value={ p.ID } selected?={ p.ID == preselectedProjectID }>{ projectOptionLabel(p) }</option>
						}
					</select>
				}
				@web.Field("Title", "") {
					<input class="input" name="title" required placeholder="e.g. Conservation Report — 2026-014"/>
				}
				<button type="submit" class="btn btn-primary">
					@web.Icon("check_circle", 14)
					Create report
				</button>
			</form>
		}
	}
}

// AddModalBody is the Asset/Project detail pages' "Reports" section +Add content. When opened
// from a Project page projectID is preset (hidden input, no picker); when opened from an Asset
// page (which may have several projects) projects lists just that asset's own projects.
templ AddModalBody(projectID string, projects []ProjectOption) {
	<form method="post" action="/reports" class="form-grid">
		if projectID != "" {
			<input type="hidden" name="projectId" value={ projectID }/>
		} else {
			@web.Field("Project", "") {
				<select class="input" name="projectId" required>
					<option value="" disabled selected>Select a project…</option>
					for _, p := range projects {
						<option value={ p.ID }>{ p.Title }</option>
					}
				</select>
			}
		}
		@web.Field("Title", "") {
			<input class="input" name="title" required placeholder="e.g. Conservation Report — 2026-014"/>
		}
		<button type="submit" class="btn btn-primary">
			@web.Icon("check_circle", 14)
			Create report
		</button>
	</form>
}

func projectOptionLabel(p ProjectOption) string {
	name := p.AssetRef
	if p.AssetTitle.Valid && p.AssetTitle.String != "" {
		name = p.AssetTitle.String
	}
	return p.Title + " — " + name + " — " + p.ClientName
}

templ DetailPage(c web.Chrome, report Report,
	projectAssessments []assessments.ListRow, projectTreatments []treatments.ListRow,
	gallery []GalleryItem, infoPanel InfoPanel) {
	@web.AppLayout(report.Title, c, detailBody(report, projectAssessments, projectTreatments, gallery, infoPanel))
}

// detailBody's block order is deliberate: Client/Asset/Project info leads (the real-world context
// a reader needs before anything else), then the report's own three sections, then its reference
// lists and gallery, then the layout customization card last.
templ detailBody(report Report,
	projectAssessments []assessments.ListRow, projectTreatments []treatments.ListRow,
	gallery []GalleryItem, infoPanel InfoPanel) {
	<div class="page-header">
		<div class="page-header-row">
			<h1>
				{ report.Title }
				if report.Status == "final" {
					<span class="badge badge-green">Final</span>
				} else {
					<span class="badge badge-amber">Draft</span>
				}
			</h1>
			<div class="actions">
				@web.ExportLinks("report", report.ID)
				if report.Status == "final" {
					<form method="post" action={ templ.URL("/reports/" + report.ID + "/status") }>
						<input type="hidden" name="status" value="draft"/>
						<button type="submit" class="btn btn-secondary" aria-label="Revert draft" title="Revert draft">
							@web.Icon("edit", 14)
							<span class="btn-label">Revert draft</span>
						</button>
					</form>
				} else {
					<form method="post" action={ templ.URL("/reports/" + report.ID + "/status") }>
						<input type="hidden" name="status" value="final"/>
						<button type="submit" class="btn btn-secondary" aria-label="Mark final" title="Mark final">
							@web.Icon("check_circle", 14)
							<span class="btn-label">Mark final</span>
						</button>
					</form>
				}
				<form method="post" action={ templ.URL("/reports/" + report.ID + "/unlink") } data-confirm={ "Remove \"" + report.Title + "\"? It stays in the database but won't show here anymore." }>
					<button type="submit" class="btn btn-ghost" aria-label="Remove" title="Remove">
						@web.Icon("close", 14)
						<span class="btn-label">Remove</span>
					</button>
				</form>
			</div>
		</div>
	</div>
	@web.Card() {
		<h2 class="dashboard-heading">Client / Asset / Project info</h2>
		@infoFieldList("Client", "/clients/"+infoPanel.ClientID, infoPanel.Client)
		@infoFieldList("Asset", "/assets/"+report.AssetID, infoPanel.Asset)
		@infoFieldList("Project", "/projects/"+report.ProjectID, infoPanel.Project)
		<p class="page-subtitle">Configurable in Settings → Features → Reportable fields.</p>
		if report.CoverMediaID.Valid {
			<hr class="section-divider"/>
			<div class="cover-photo-preview">
				<img class="entity-thumb" src={ "/api/media/" + report.CoverMediaID.String } alt=""/>
				<span class="page-subtitle">Cover photo</span>
			</div>
		}
	}
	@web.Card() {
		<form method="post" action={ templ.URL("/reports/" + report.ID + "/sections") } class="form-grid">
			@web.Field("Description", "") {
				<textarea class="input" name="description" rows="3" readonly?={ report.Status == "final" }>{ report.Description.String }</textarea>
			}
			@web.Field("Summary", "") {
				<textarea class="input" name="summary" rows="3" readonly?={ report.Status == "final" }>{ report.Summary.String }</textarea>
			}
			@web.Field("Recommendations", "") {
				<textarea class="input" name="recommendations" rows="3" readonly?={ report.Status == "final" }>{ report.Recommendations.String }</textarea>
			}
			if report.Status != "final" {
				<button type="submit" class="btn btn-primary">
					@web.Icon("check_circle", 14)
					Save sections
				</button>
			}
		</form>
	}
	@web.Card() {
		<h2 class="dashboard-heading">Assessments</h2>
		if len(projectAssessments) == 0 {
			<p class="empty-state">No assessments recorded for this project.</p>
		} else {
			<ul class="entity-list">
				for _, a := range projectAssessments {
					<li class="entity-list-row">
						<a href={ templ.URL("/assessments/" + a.ID) } class="entity-list-name">
							{ a.Condition }
							if a.Description != "" {
								<div class="page-subtitle">{ a.Description }</div>
							}
						</a>
						<div class="row-actions">
							@web.TableRowChips() {
								<span class="page-subtitle">{ a.RecordedAt.Format("2006-01-02") }</span>
							}
							@web.TableRowActions() {
								<a href={ templ.URL("/assessments/" + a.ID) } class="row-action-icon" title="View">
									@web.Icon("chevron_right", 14)
								</a>
							}
						</div>
					</li>
				}
			</ul>
		}
	}
	@web.Card() {
		<h2 class="dashboard-heading">Treatments</h2>
		if len(projectTreatments) == 0 {
			<p class="empty-state">No treatments logged for this project.</p>
		} else {
			<ul class="entity-list">
				for _, t := range projectTreatments {
					<li class="entity-list-row">
						<a href={ templ.URL("/treatments/" + t.ID) } class="entity-list-name">{ t.Title }</a>
						<div class="row-actions">
							@web.TableRowChips() {
								<span class="badge">{ t.Method }</span>
								<span class="page-subtitle">{ t.PerformedAt.Format("2006-01-02") }</span>
							}
							@web.TableRowActions() {
								<a href={ templ.URL("/treatments/" + t.ID) } class="row-action-icon" title="View">
									@web.Icon("chevron_right", 14)
								</a>
							}
						</div>
					</li>
				}
			</ul>
		}
	}
	@web.Card() {
		<div class="card-header-row">
			<h2 class="dashboard-heading">Image gallery</h2>
			<form method="post" action={ templ.URL("/reports/" + report.ID + "/gallery/columns") } class="pattern-layer-select-field" data-autosubmit-on-change>
				Columns
				<select class="input" name="columns">
					<option value="1" selected?={ report.GalleryColumns == 1 }>1</option>
					<option value="2" selected?={ report.GalleryColumns != 1 }>2</option>
				</select>
			</form>
		</div>
		if report.Status != "final" {
			<form method="post" action={ templ.URL("/reports/" + report.ID + "/attachments") } enctype="multipart/form-data" class="form-grid gallery-upload-form">
				<div class="file-input-row">
					<input type="file" id="gallery-upload-input" name="photos" multiple accept="image/*" class="sr-only"/>
					<label for="gallery-upload-input" class="btn btn-secondary">
						@web.Icon("upload", 14)
						Choose images…
					</label>
					<input type="text" class="input" name="photosCaption" placeholder="Name / caption"/>
					<button type="submit" class="btn btn-primary">
						@web.Icon("add", 14)
						Upload
					</button>
				</div>
			</form>
		}
		if len(gallery) == 0 {
			<p class="empty-state">No images yet for this project.</p>
		}
		<div
			id="report-gallery-grid"
			class={ "gallery-grid", templ.KV("gallery-grid-1col", report.GalleryColumns == 1) }
			data-reorder-url={ "/reports/" + report.ID + "/gallery/reorder" }
		>
			for _, item := range gallery {
				<div class="gallery-item" data-ref-id={ item.ID }>
					<a href={ templ.URL("/media/view/" + item.MediaID) }>
						<img class={ "gallery-photo", templ.KV("gallery-item-stretch", item.Stretch) } src={ "/api/media/" + item.MediaID } alt=""/>
					</a>
					<form method="post" action={ templ.URL("/reports/" + report.ID + "/media/" + item.ID + "/caption") } class="gallery-item-form">
						<input class="input" type="text" name="caption" placeholder="Description…" value={ item.Caption.String } readonly?={ report.Status == "final" }/>
						if report.Status != "final" {
							<label class="checkbox-field" title="Stretch to column width">
								<input type="checkbox" name="stretch" checked?={ item.Stretch }/>
								Stretch
							</label>
							<button type="submit" class="btn btn-ghost" title="Save" aria-label="Save">
								@web.Icon("check_circle", 14)
							</button>
						}
					</form>
				</div>
			}
		</div>
		<script src="/static/js/report-gallery.js" defer></script>
	}
	@web.Card() {
		<h2 class="dashboard-heading">Customize layout</h2>
		<form method="post" action={ templ.URL("/reports/" + report.ID + "/layout") } class="form-grid">
			@web.Field("Layout style", "Standard + gallery adds every connected image (assessments, treatments, this report's own uploads) to the export, not just what's uploaded here.") {
				<select class="input" name="layoutStyle">
					for _, style := range []string{"standard", "gallery"} {
						<option value={ style } selected?={ style == report.LayoutStyle }>{ layoutStyleLabel(style) }</option>
					}
				</select>
			}
			if len(gallery) > 0 {
				@web.Field("Cover image", "Pulled from this asset's whole image gallery, not just this report's own uploads.") {
					<select class="input" name="coverMediaId">
						<option value="">None</option>
						for _, item := range gallery {
							<option value={ item.MediaID } selected?={ report.CoverMediaID.Valid && report.CoverMediaID.String == item.MediaID }>{ galleryOptionLabel(item) }</option>
						}
					</select>
				}
			}
			<div class="checkbox-grid">
				<label class="checkbox-field">
					<input type="checkbox" name="showCover" checked?={ report.ShowCover }/>
					Cover
				</label>
				<label class="checkbox-field">
					<input type="checkbox" name="showDescription" checked?={ report.ShowDescription }/>
					Description
				</label>
				<label class="checkbox-field">
					<input type="checkbox" name="showSummary" checked?={ report.ShowSummary }/>
					Summary
				</label>
				<label class="checkbox-field">
					<input type="checkbox" name="showRecommendations" checked?={ report.ShowRecommendations }/>
					Recommendations
				</label>
			</div>
			<button type="submit" class="btn btn-secondary">
				@web.Icon("check_circle", 14)
				Save layout
			</button>
		</form>
	}
}

templ infoFieldList(label, href string, fields []InfoField) {
	if len(fields) > 0 {
		<h3 class="form-section-title">
			<a href={ templ.URL(href) }>{ label }</a>
		</h3>
		<dl class="detail-dl">
			for _, f := range fields {
				<div>
					<dt class="detail-dt">{ f.Label }</dt>
					<dd class="detail-dd">{ f.Value }</dd>
				</div>
			}
		</dl>
	}
}

func layoutStyleLabel(style string) string {
	switch style {
	case "gallery":
		return "Standard + gallery"
	default:
		return "Standard"
	}
}

// galleryOptionLabel is one <option>'s text in the "Cover image" picker - the item's own caption
// when it has one (matching what the Image gallery section itself shows as its editable caption),
// falling back to its timestamp so every image is still distinguishable without one.
func galleryOptionLabel(item GalleryItem) string {
	if item.Caption.Valid && item.Caption.String != "" {
		return item.Caption.String
	}
	return item.CreatedAt.Format("2006-01-02 15:04")
}
