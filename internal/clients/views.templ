package clients

import (
	"strconv"
	"strings"

	"studio/internal/i18n"
	"studio/internal/settings"
	"studio/internal/web"
)

templ ListPage(c web.Chrome, rows []ListRow, typeLabels map[string]string, clientTypes []settings.Classifier) {
	@web.AppLayout("Clients", c, listBody(rows, typeLabels, clientTypes))
}

templ listBody(rows []ListRow, typeLabels map[string]string, clientTypes []settings.Classifier) {
	@web.PageHeader("Clients", "Every client, with their assets at a glance.", newClientLink())
	<div data-el-root>
		<div class="list-toolbar">
			@web.EntityListSearchInput("Search by name, email…")
			@web.EntityListFilterSelect("clientType", "All types", classifierFilterOptionsFromLabels(clientTypes, typeLabels))
			@web.EntityListGroupBySelect([]web.FilterOption{{Value: "clientType", Label: "Type"}})
		</div>
		if len(rows) == 0 {
			<p class="empty-state">No clients yet.</p>
		}
		<ul class="entity-list" data-el-list>
			for _, row := range rows {
				<li
					data-el-row
					data-el-search={ clientSearchHaystack(row, typeLabels) }
					data-el-client-type={ row.Type }
					data-el-group-client-type={ labelFor(typeLabels, row.Type) }
				>
					<a href={ templ.URL("/clients/" + row.ID) } class="entity-list-row">
						<span class="avatar-chip">{ clientInitials(row.Name) }</span>
						<div>
							<span class="entity-list-name">{ row.Name }</span>
							<div class="page-subtitle">
								if row.Email.Valid {
									{ row.Email.String }
								} else {
									no email on file
								}
							</div>
						</div>
						<div class="row-actions">
							<span class="badge tag-chip" data-el-tag-filter="clientType" data-el-tag-value={ row.Type } role="button" tabindex="0">{ labelFor(typeLabels, row.Type) }</span>
							<span class="page-subtitle">{ strconv.Itoa(row.AssetCount) } assets</span>
						</div>
						<img src="/static/icons/chevron-right.svg" width="16" height="16" alt="" class="icon entity-list-chevron"/>
					</a>
				</li>
			}
		</ul>
	</div>
	<script src="/static/js/entity-list-filter.js" defer></script>
}

// classifierFilterOptionsFromLabels builds filter options from an already-fetched
// []settings.Classifier plus a locale-resolved label map (avoids a second, redundant classifier
// fetch just for the filter's option labels — handleList already has both).
func classifierFilterOptionsFromLabels(classifiers []settings.Classifier, labels map[string]string) []web.FilterOption {
	out := make([]web.FilterOption, len(classifiers))
	for i, c := range classifiers {
		out[i] = web.FilterOption{Value: c.Code, Label: labelFor(labels, c.Code)}
	}
	return out
}

func clientSearchHaystack(row ListRow, typeLabels map[string]string) string {
	email := ""
	if row.Email.Valid {
		email = row.Email.String
	}
	return row.Name + " " + email + " " + labelFor(typeLabels, row.Type)
}

func labelFor(m map[string]string, code string) string {
	if l, ok := m[code]; ok {
		return l
	}
	return code
}

// clientInitials renders up to the first two words of a client name as uppercase letters, for
// the entity-list avatar chip.
func clientInitials(name string) string {
	fields := strings.Fields(name)
	out := ""
	for i, f := range fields {
		if i >= 2 {
			break
		}
		out += strings.ToUpper(f[:1])
	}
	return out
}

templ newClientLink() {
	<a class="btn btn-primary" href="/clients/new">
		<img src="/static/icons/add.svg" width="16" height="16" alt="" class="icon icon-invert"/>
		New client
	</a>
}

templ NewPage(c web.Chrome, clientTypes, contactMethods []settings.Classifier) {
	@web.AppLayout("New client", c, newBody(clientTypes, contactMethods, c.Locale))
}

templ newBody(clientTypes, contactMethods []settings.Classifier, locale i18n.Locale) {
	@web.PageHeader("New client", "", templ.NopComponent)
	@web.Card() {
		<form method="post" action="/clients" class="form-grid">
			<div class="form-row-2">
				@web.Field("Type", "") {
					@web.ClassifierAutocomplete("type", "client_type", "code", firstCode(clientTypes), "Select a type…", settings.ClassifierAutocompleteOptions(clientTypes, locale))
				}
				@web.Field("Name", "") {
					<input class="input" name="name" required placeholder="Jane Doe"/>
				}
			</div>
			<div class="form-row-2">
				@web.Field("Organization", "") {
					<input class="input" name="organizationName"/>
				}
				@web.Field("Contact person", "") {
					<input class="input" name="contactPerson"/>
				}
			</div>
			<div class="form-row-3">
				@web.Field("Email", "") {
					<input class="input" type="email" name="email" placeholder="jane@example.com"/>
				}
				@web.Field("Phone", "") {
					<input class="input" name="phone" placeholder="+1 555 0100"/>
				}
				@web.Field("Preferred contact method", "") {
					@web.ClassifierAutocomplete("preferredContactMethod", "contact_method", "code", "", "—", settings.ClassifierAutocompleteOptions(contactMethods, locale))
				}
			</div>
			@web.Field("Address", "") {
				<textarea class="input" name="address" rows="2"></textarea>
			}
			<div class="form-row-3">
				@web.Field("City", "") {
					<input class="input" name="city"/>
				}
				@web.Field("Postal code", "") {
					<input class="input" name="postalCode"/>
				}
				@web.Field("Country", "") {
					<input class="input" name="country"/>
				}
			</div>
			<div class="form-row-2">
				@web.Field("Tax ID", "") {
					<input class="input" name="taxId"/>
				}
				@web.Field("Referral source", "") {
					<input class="input" name="referralSource"/>
				}
			</div>
			@web.Field("Notes", "") {
				<textarea class="input" name="notes" rows="3"></textarea>
			}
			<button type="submit" class="btn btn-primary">
				<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon icon-invert"/>
				Create
			</button>
		</form>
	}
	<script src="/static/js/classifier-autocomplete.js" defer></script>
}

// firstCode mirrors a plain <select>'s implicit "first option is selected by default" behavior —
// ClassifierAutocomplete needs that default spelled out since an empty, untouched text field
// would otherwise submit blank instead of the classifier a bare <select> used to default to.
func firstCode(classifiers []settings.Classifier) string {
	if len(classifiers) == 0 {
		return ""
	}
	return classifiers[0].Code
}

templ DetailPage(c web.Chrome, client Client, typeLabel string, assets []AssetSummary, clientTypes, contactMethods []settings.Classifier) {
	@web.AppLayout(client.Name, c, detailBody(client, typeLabel, assets, clientTypes, contactMethods))
}

templ detailBody(client Client, typeLabel string, assets []AssetSummary, clientTypes, contactMethods []settings.Classifier) {
	@web.PageHeader(client.Name, detailSubtitle(client, typeLabel), clientActions(client))
	@web.Card() {
		<div class="card-header-row">
			<h2 class="dashboard-heading">Assets</h2>
			<a class="btn btn-secondary" href={ templ.URL("/assets/new?clientId=" + client.ID) }>
				<img src="/static/icons/add.svg" width="14" height="14" alt="" class="icon"/>
				Add asset
			</a>
		</div>
		if len(assets) == 0 {
			<p class="empty-state">No assets yet.</p>
		}
		<ul class="entity-list">
			for _, a := range assets {
				<li class="entity-list-row">
					<a href={ templ.URL("/assets/" + a.ID) }>
						if a.Title.Valid {
							{ a.Title.String }
						} else {
							{ a.ReferenceCode }
						}
					</a>
					<span class="page-subtitle">{ a.ReferenceCode }</span>
				</li>
			}
		</ul>
	}
}

templ clientActions(client Client) {
	<a class="btn btn-secondary" href={ templ.URL("/clients/edit/" + client.ID) }>
		<img src="/static/icons/edit.svg" width="14" height="14" alt="" class="icon"/>
		Edit
	</a>
}

templ EditPage(c web.Chrome, client Client, clientTypes, contactMethods []settings.Classifier) {
	@web.AppLayout("Edit "+client.Name, c, editBody(client, clientTypes, contactMethods, c.Locale))
}

templ editBody(client Client, clientTypes, contactMethods []settings.Classifier, locale i18n.Locale) {
	@web.PageHeader("Edit "+client.Name, "", templ.NopComponent)
	@web.Card() {
		<form method="post" action={ templ.URL("/clients/" + client.ID + "/update") } class="form-grid">
			@web.Field("Type", "") {
				@web.ClassifierAutocomplete("type", "client_type", "code", client.Type, "Select a type…", settings.ClassifierAutocompleteOptions(clientTypes, locale))
			}
			@web.Field("Name", "") {
				<input class="input" name="name" value={ client.Name } required/>
			}
			@web.Field("Organization", "") {
				<input class="input" name="organizationName" value={ client.OrganizationName.String }/>
			}
			@web.Field("Contact person", "") {
				<input class="input" name="contactPerson" value={ client.ContactPerson.String }/>
			}
			@web.Field("Email", "") {
				<input class="input" type="email" name="email" value={ client.Email.String }/>
			}
			@web.Field("Phone", "") {
				<input class="input" name="phone" value={ client.Phone.String }/>
			}
			@web.Field("Preferred contact method", "") {
				@web.ClassifierAutocomplete("preferredContactMethod", "contact_method", "code", client.PreferredContactMethod.String, "—", settings.ClassifierAutocompleteOptions(contactMethods, locale))
			}
			@web.Field("Address", "") {
				<textarea class="input" name="address" rows="2">{ client.Address.String }</textarea>
			}
			<div class="form-row-2">
				@web.Field("City", "") {
					<input class="input" name="city" value={ client.City.String }/>
				}
				@web.Field("Postal code", "") {
					<input class="input" name="postalCode" value={ client.PostalCode.String }/>
				}
			</div>
			@web.Field("Country", "") {
				<input class="input" name="country" value={ client.Country.String }/>
			}
			@web.Field("Tax ID", "") {
				<input class="input" name="taxId" value={ client.TaxID.String }/>
			}
			@web.Field("Referral source", "") {
				<input class="input" name="referralSource" value={ client.ReferralSource.String }/>
			}
			@web.Field("Notes", "") {
				<textarea class="input" name="notes" rows="4">{ client.Notes.String }</textarea>
			}
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">
					<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon icon-invert"/>
					Save
				</button>
				<a class="btn btn-ghost" href={ templ.URL("/clients/" + client.ID) }>
					<img src="/static/icons/close.svg" width="14" height="14" alt="" class="icon"/>
					Cancel
				</a>
			</div>
		</form>
	}
	<script src="/static/js/classifier-autocomplete.js" defer></script>
}

func detailSubtitle(client Client, typeLabel string) string {
	email := "no email"
	if client.Email.Valid {
		email = client.Email.String
	}
	phone := "no phone"
	if client.Phone.Valid {
		phone = client.Phone.String
	}
	return typeLabel + " · " + email + " · " + phone
}
