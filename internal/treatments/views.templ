package treatments

import (
	"database/sql"

	"studio/internal/i18n"
	"studio/internal/media"
	"studio/internal/settings"
	"studio/internal/web"
)

templ ListPage(c web.Chrome, rows []ListRow, methodLabels map[string]string, methods []settings.Classifier) {
	@web.AppLayout("Treatments", c, listBody(rows, methodLabels, methods))
}

templ listBody(rows []ListRow, methodLabels map[string]string, methods []settings.Classifier) {
	@web.PageHeader("Treatments", "Conservation work performed, per object.", web.NewActionLink("/treatments/new", "New treatment"))
	<div data-el-root>
		<div class="list-toolbar">
			@web.EntityListSearchInput("Search by title, asset, client…")
			@web.EntityListFilterSelect("method", "All methods", classifierFilterOptionsFromLabels(methods, methodLabels))
			@web.EntityListGroupBySelect([]web.FilterOption{
				{Value: "asset", Label: "Asset"},
				{Value: "client", Label: "Client"},
				{Value: "method", Label: "Method"},
			})
		</div>
		if len(rows) == 0 {
			<p class="empty-state">No treatments logged yet.</p>
		}
		<ul class="entity-list" data-el-list>
			for _, row := range rows {
				<li
					data-el-row
					data-el-search={ treatmentSearchHaystack(row, methodLabels) }
					data-el-method={ row.Method }
					data-el-group-asset={ assetLabel(row.AssetTitle, row.AssetReferenceCode) }
					data-el-group-client={ row.ClientName }
					data-el-group-method={ methodLabel(methodLabels, row.Method) }
				>
					<a href={ templ.URL("/treatments/" + row.ID) } class="entity-list-row">
						<div>
							<span class="entity-list-name">{ row.Title }</span>
							<div class="page-subtitle">
								if row.AssetTitle.Valid {
									{ row.AssetTitle.String }
								} else {
									{ row.AssetReferenceCode }
								}
								· owner: { row.ClientName }
							</div>
						</div>
						<div class="row-actions">
							<span class="badge tag-chip" data-el-tag-filter="method" data-el-tag-value={ row.Method } role="button" tabindex="0">{ methodLabel(methodLabels, row.Method) }</span>
							<span class="page-subtitle">{ row.PerformedAt.Format("2006-01-02") }</span>
						</div>
					</a>
				</li>
			}
		</ul>
	</div>
	<script src="/static/js/entity-list-filter.js" defer></script>
}

// classifierFilterOptionsFromLabels builds filter options from an already-fetched
// []settings.Classifier plus a locale-resolved label map (avoids a second, redundant classifier
// fetch just for the filter's option labels — handleList already has both).
func classifierFilterOptionsFromLabels(classifiers []settings.Classifier, labels map[string]string) []web.FilterOption {
	out := make([]web.FilterOption, len(classifiers))
	for i, c := range classifiers {
		out[i] = web.FilterOption{Value: c.Code, Label: methodLabel(labels, c.Code)}
	}
	return out
}

func assetLabel(title sql.NullString, referenceCode string) string {
	if title.Valid && title.String != "" {
		return title.String
	}
	return referenceCode
}

func treatmentSearchHaystack(row ListRow, methodLabels map[string]string) string {
	return row.Title + " " + assetLabel(row.AssetTitle, row.AssetReferenceCode) + " " + row.ClientName + " " + methodLabel(methodLabels, row.Method)
}

templ NewPage(c web.Chrome, projects []ProjectOption, methods []settings.Classifier, preselectedProjectID string) {
	@web.AppLayout("New treatment", c, newBody(projects, methods, preselectedProjectID, c.Locale))
}

templ newBody(projects []ProjectOption, methods []settings.Classifier, preselectedProjectID string, locale i18n.Locale) {
	@web.PageHeader("New treatment", "", templ.NopComponent)
	@web.Card() {
		if len(projects) == 0 {
			<p class="empty-state">No projects yet — <a href="/projects/new">start one</a> first.</p>
		} else {
			<form method="post" action="/treatments" enctype="multipart/form-data" class="form-grid">
				@web.Field("Project", "") {
					<select class="input" name="projectId" required>
						<option value="" disabled selected?={ preselectedProjectID == "" }>Select a project…</option>
						for _, p := range projects {
							<option value={ p.ID } selected?={ p.ID == preselectedProjectID }>{ projectOptionLabel(p) }</option>
						}
					</select>
				}
				@treatmentFields("", "", "", methods, locale)
				@web.Field("Performed at", "") {
					<input class="input" type="datetime-local" name="performedAt"/>
				}
				@web.FileInput("photos", "Photos", "On a phone this opens your camera directly.")
				<button type="submit" class="btn btn-primary">
					<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon icon-invert"/>
					Log treatment
				</button>
			</form>
		}
	}
	<script src="/static/js/classifier-autocomplete.js" defer></script>
}

func projectOptionLabel(p ProjectOption) string {
	name := p.AssetRef
	if p.AssetTitle.Valid && p.AssetTitle.String != "" {
		name = p.AssetTitle.String
	}
	return p.Title + " — " + name + " — " + p.ClientName
}

templ DetailPage(c web.Chrome, treatment DetailRow, methodLabels map[string]string, performedByName string, photos []media.ReferenceWithMedia) {
	@web.AppLayout(treatment.Title, c, detailBody(treatment, methodLabels, performedByName, photos))
}

templ detailBody(treatment DetailRow, methodLabels map[string]string, performedByName string, photos []media.ReferenceWithMedia) {
	@web.PageHeader(treatment.Title, detailSubtitle(treatment), detailActions(treatment))
	@web.Card() {
		<dl class="detail-dl">
			@detailField("Method", methodLabel(methodLabels, treatment.Method))
			@detailField("Performed at", treatment.PerformedAt.Format("2006-01-02 15:04"))
			@detailField("Performed by", performedByName)
		</dl>
		<p class="detail-paragraph">{ treatment.Notes }</p>
		@media.MediaGrid(photos)
	}
}

templ detailField(label, value string) {
	<div>
		<dt class="detail-dt">{ label }</dt>
		<dd class="detail-dd">
			if value == "" {
				—
			} else {
				{ value }
			}
		</dd>
	</div>
}

func methodLabel(labels map[string]string, code string) string {
	if label, ok := labels[code]; ok {
		return label
	}
	return code
}

templ detailActions(treatment DetailRow) {
	<a class="btn btn-ghost" href={ templ.URL("/projects/" + treatment.ProjectID) }>
		<img src="/static/icons/chevron-right.svg" width="14" height="14" alt="" class="icon"/>
		View project
	</a>
	<a class="btn btn-ghost" href={ templ.URL("/assets/" + treatment.AssetID) }>
		<img src="/static/icons/chevron-right.svg" width="14" height="14" alt="" class="icon"/>
		View asset
	</a>
	<a class="btn btn-secondary" href={ templ.URL("/treatments/" + treatment.ID + "/edit") }>
		<img src="/static/icons/edit.svg" width="14" height="14" alt="" class="icon"/>
		Edit
	</a>
	<form method="post" action={ templ.URL("/treatments/" + treatment.ID + "/unlink") } data-confirm={ "Unlink \"" + treatment.Title + "\"? It stays in the database but won't show here anymore." }>
		<button type="submit" class="btn btn-ghost">
			<img src="/static/icons/close.svg" width="14" height="14" alt="" class="icon"/>
			Unlink
		</button>
	</form>
}

templ EditPage(c web.Chrome, treatment Treatment, methods []settings.Classifier) {
	@web.AppLayout("Edit "+treatment.Title, c, editBody(treatment, methods, c.Locale))
}

templ editBody(treatment Treatment, methods []settings.Classifier, locale i18n.Locale) {
	@web.PageHeader("Edit "+treatment.Title, "", templ.NopComponent)
	@web.Card() {
		<form method="post" action={ templ.URL("/treatments/" + treatment.ID + "/update") } class="form-grid">
			@treatmentFields(treatment.Method, treatment.Title, treatment.Notes, methods, locale)
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">
					<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon icon-invert"/>
					Save
				</button>
				<a class="btn btn-ghost" href={ templ.URL("/treatments/" + treatment.ID) }>
					<img src="/static/icons/close.svg" width="14" height="14" alt="" class="icon"/>
					Cancel
				</a>
			</div>
		</form>
	}
	<script src="/static/js/classifier-autocomplete.js" defer></script>
}

// treatmentFields is the Method/Title/Notes field trio shared by the edit form here and the
// asset detail page's "+Add" modal (see AddModalBody below) — assetId/performedAt/photos differ
// per caller so they're not part of this shared slot.
templ treatmentFields(method, title, notes string, methods []settings.Classifier, locale i18n.Locale) {
	@web.Field("Method", "") {
		@web.ClassifierAutocomplete("method", "treatment_method", "code", method, "Select…", settings.ClassifierAutocompleteOptions(methods, locale))
	}
	@web.Field("Title", "e.g. \"Surface cleaning — lower right quadrant\"") {
		<input class="input" name="title" required value={ title }/>
	}
	@web.Field("Notes", "") {
		<textarea class="input" name="notes" rows="4" required>{ notes }</textarea>
	}
}

// AddModalBody is the Asset/Project detail pages' "Treatments" section +Add content. When opened
// from a Project page projectID is preset (hidden input, no picker); when opened from an Asset
// page (which may have several projects) projects lists just that asset's own projects.
templ AddModalBody(projectID string, projects []ProjectOption, methods []settings.Classifier, locale i18n.Locale) {
	<form method="post" action="/treatments" enctype="multipart/form-data" class="form-grid">
		if projectID != "" {
			<input type="hidden" name="projectId" value={ projectID }/>
		} else {
			@web.Field("Project", "") {
				<select class="input" name="projectId" required>
					<option value="" disabled selected>Select a project…</option>
					for _, p := range projects {
						<option value={ p.ID }>{ p.Title }</option>
					}
				</select>
			}
		}
		@treatmentFields("", "", "", methods, locale)
		@web.FileInput("photos", "Photos", "On a phone this opens your camera directly.")
		<button type="submit" class="btn btn-primary">
			<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon icon-invert"/>
			Log treatment
		</button>
	</form>
	<script src="/static/js/classifier-autocomplete.js" defer></script>
}

func detailSubtitle(treatment DetailRow) string {
	assetName := treatment.AssetReferenceCode
	if treatment.AssetTitle.Valid && treatment.AssetTitle.String != "" {
		assetName = treatment.AssetTitle.String
	}
	return assetName + " · owner: " + treatment.ClientName
}
