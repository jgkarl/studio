package workflows

import (
	"strconv"

	"studio/internal/assets"
	"studio/internal/clients"
	"studio/internal/media"
	"studio/internal/settings"
	"studio/internal/web"
)

templ ListPage(c web.Chrome, rows []ListRow) {
	@web.AppLayout("Workflows", c, listBody(rows))
}

templ listBody(rows []ListRow) {
	@web.PageHeader("Workflows", "The Notebook — one unit of conservation work per Asset.", newWorkflowLink())
	@web.Card() {
		if len(rows) == 0 {
			<p class="empty-state">No workflows yet.</p>
		}
		<ul class="entity-list">
			for _, row := range rows {
				<li class="entity-list-row">
					<div>
						<a href={ templ.URL("/workflows/" + row.ID) } class="entity-list-name">{ row.Title }</a>
						<div class="page-subtitle">
							if row.AssetTitle.Valid {
								{ row.AssetTitle.String }
							} else {
								{ row.AssetReferenceCode }
							}
							· owner: { row.ClientName }
							if row.OrderNumber.Valid {
								· order { row.OrderNumber.String }
							} else {
								· no order yet
							}
						</div>
					</div>
					@web.OpenBadge(row.CompletedAt.Valid)
				</li>
			}
		</ul>
	}
}

templ newWorkflowLink() {
	<a class="btn btn-primary" href="/workflows/new">
		<img src="/static/icons/add.svg" width="16" height="16" alt="" class="icon icon-invert"/>
		New workflow
	</a>
}

templ NewPage(c web.Chrome, options []AssetOption, preselectedAssetID string) {
	@web.AppLayout("New workflow", c, newBody(options, preselectedAssetID))
}

templ newBody(options []AssetOption, preselectedAssetID string) {
	@web.PageHeader("New workflow", "", templ.NopComponent)
	@web.Card() {
		<form method="post" action="/workflows" class="form-grid">
			@web.Field("Asset", "") {
				<select class="input" name="assetId" required>
					<option value="" disabled selected?={ preselectedAssetID == "" }>Select an asset…</option>
					for _, a := range options {
						<option value={ a.ID } selected?={ a.ID == preselectedAssetID }>{ assetOptionLabel(a) }</option>
					}
				</select>
			}
			@web.Field("Title", "e.g. \"Cleaning and varnish removal\"") {
				<input class="input" name="title" required/>
			}
			<button type="submit" class="btn btn-primary">
				<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon icon-invert"/>
				Create
			</button>
		</form>
	}
}

func assetOptionLabel(a AssetOption) string {
	name := a.ReferenceCode
	if a.Title.Valid && a.Title.String != "" {
		name = a.Title.String
	}
	return name + " — " + a.ClientName
}

templ DetailPage(c web.Chrome, project Project, asset *assets.Asset, client *clients.Client, activities []Activity,
	activityMedia map[string][]media.ReferenceWithMedia, activityTypes, conditions []settings.Classifier) {
	@web.AppLayout(project.Title, c, detailBody(project, asset, client, activities, activityMedia, activityTypes, conditions))
}

templ detailBody(project Project, asset *assets.Asset, client *clients.Client, activities []Activity,
	activityMedia map[string][]media.ReferenceWithMedia, activityTypes, conditions []settings.Classifier) {
	@web.PageHeader(project.Title, detailSubtitle(asset, client), detailActions(project, asset))

	@web.Card() {
		<div class="row-actions" style="margin-bottom: 1rem;">
			@web.OpenBadge(project.CompletedAt.Valid)
			if !project.OrderID.Valid && client != nil {
				<span class="page-subtitle">
					Not yet attached to an order —
					<a href={ templ.URL("/clients/quotes/new?clientId=" + client.ID) } style="text-decoration: underline;">start a quote</a>.
				</span>
			}
		</div>

		<h2 class="dashboard-heading">Notebook <span class="page-subtitle">(newest first)</span></h2>
		if len(activities) == 0 {
			<p class="empty-state">No activity logged yet.</p>
		}
		<ul class="condition-list">
			for _, a := range activities {
				<li class="condition-item">
					<div class="row-actions">
						<span class="badge">{ a.ActivityTypeTitle }</span>
						<span class="page-subtitle">
							{ a.StartedAt.Format("2006-01-02 15:04") } · { a.UserName }
							if a.DurationMinutes.Valid {
								· { strconv.FormatInt(a.DurationMinutes.Int64, 10) } min
							}
						</span>
					</div>
					<p class="detail-paragraph">{ a.Description }</p>
					@media.MediaGrid(activityMedia[a.ID])
				</li>
			}
		</ul>

		<details class="form-section">
			<summary class="form-section-title" style="cursor: pointer;">+ Log activity</summary>
			<form method="post" action={ templ.URL("/workflows/" + project.ID + "/activities") } enctype="multipart/form-data" class="form-grid" style="margin-top: 1rem;">
				@web.Field("Type", "") {
					<select class="input" name="activityTypeId" required>
						<option value="" disabled selected>Select…</option>
						for _, at := range activityTypes {
							<option value={ at.ID }>{ at.Title }</option>
						}
					</select>
				}
				@web.Field("Notes", "") {
					<textarea class="input" name="description" rows="3" required></textarea>
				}
				<div class="form-row-2">
					@web.Field("Started", "") {
						<input class="input" type="datetime-local" name="startedAt"/>
					}
					@web.Field("Time it took, minutes", "") {
						<input class="input" type="number" name="durationMinutes" min="0"/>
					}
				</div>
				@web.Field("Materials used", "free text, optional") {
					<input class="input" name="materialsUsed" placeholder="e.g. 20ml solvent, cotton swabs"/>
				}
				@web.Field("Fixates condition as", "only used if this activity type is a state-fixation type") {
					<select class="input" name="condition">
						for _, cond := range conditions {
							<option value={ cond.Code }>{ cond.Title }</option>
						}
					</select>
				}
				@web.Field("Photos", "On a phone this opens your camera directly.") {
					<input type="file" name="photos" multiple accept="image/*,video/*" capture="environment"/>
				}
				<button type="submit" class="btn btn-primary">
					<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon icon-invert"/>
					Log entry
				</button>
			</form>
		</details>
	}
}

templ detailActions(project Project, asset *assets.Asset) {
	if asset != nil {
		<a class="btn btn-ghost" href={ templ.URL("/assets/" + asset.ID) }>
			<img src="/static/icons/chevron-right.svg" width="14" height="14" alt="" class="icon"/>
			View asset
		</a>
	}
	@web.ExportLinks("project", project.ID)
	if !project.CompletedAt.Valid {
		<form method="post" action={ templ.URL("/workflows/" + project.ID + "/complete") }>
			<button type="submit" class="btn btn-primary">
				<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon icon-invert"/>
				Mark complete
			</button>
		</form>
	}
}

func detailSubtitle(asset *assets.Asset, client *clients.Client) string {
	assetName := ""
	if asset != nil {
		assetName = asset.DisplayName()
	}
	clientName := ""
	if client != nil {
		clientName = client.Name
	}
	return assetName + " · owner: " + clientName
}
