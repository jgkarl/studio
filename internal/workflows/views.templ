package workflows

import (
	"strconv"

	"stuudio/internal/assessments"
	"stuudio/internal/assets"
	"stuudio/internal/clients"
	"stuudio/internal/i18n"
	"stuudio/internal/media"
	"stuudio/internal/reporter"
	"stuudio/internal/settings"
	"stuudio/internal/treatments"
	"stuudio/internal/web"
)

// ListPage is the Projects kanban board — one column per project_stage Classifier code, cards
// dragged between columns via static/js/kanban.js posting to POST /projects/{id}/stage.
templ ListPage(c web.Chrome, rows []ListRow, stages []settings.Classifier) {
	@web.AppLayout("Projects", c, listBody(rows, stages, c.Locale))
}

templ listBody(rows []ListRow, stages []settings.Classifier, locale i18n.Locale) {
	@web.PageHeader("Projects", "Drag a card to move it to the next stage.", newWorkflowLink())
	<div class="list-toolbar">
		<span class="search-wrap">
			<img src="/static/icons/search.svg" width="16" height="16" alt="" class="icon"/>
			<input type="text" id="kanban-search" placeholder="Search by title, asset, client…"/>
		</span>
	</div>
	<div class="kanban-board" id="kanban-board" data-url-template="/projects/{id}/stage" data-status-field="stage">
		for _, stage := range stages {
			<div class="kanban-column" data-status={ stage.Code }>
				<div class="kanban-column-header">
					<h3>{ settings.ClassifierLabel(stage, locale) }</h3>
					<span class="page-subtitle">{ countByStage(rows, stage.Code) }</span>
				</div>
				<div class="kanban-column-body" data-status={ stage.Code }>
					for _, row := range rows {
						if row.Stage == stage.Code {
							@kanbanCard(row)
						}
					}
				</div>
			</div>
		}
	</div>
	<script src="/static/js/kanban.js" defer></script>
}

templ kanbanCard(row ListRow) {
	<div class="kanban-card" draggable="true" data-item-id={ row.ID } data-search={ kanbanCardSearchHaystack(row) } data-href={ "/projects/" + row.ID }>
		<a href={ templ.URL("/projects/" + row.ID) } class="entity-list-name">{ row.Title }</a>
		<div class="page-subtitle">
			if row.AssetTitle.Valid {
				{ row.AssetTitle.String }
			} else {
				{ row.AssetReferenceCode }
			}
			· owner: { row.ClientName }
		</div>
	</div>
}

func kanbanCardSearchHaystack(row ListRow) string {
	return row.Title + " " + assetOptionSearchLabel(row) + " " + row.ClientName
}

func assetOptionSearchLabel(row ListRow) string {
	if row.AssetTitle.Valid && row.AssetTitle.String != "" {
		return row.AssetTitle.String
	}
	return row.AssetReferenceCode
}

func countByStage(rows []ListRow, stage string) string {
	n := 0
	for _, r := range rows {
		if r.Stage == stage {
			n++
		}
	}
	return strconv.Itoa(n)
}

templ newWorkflowLink() {
	<a class="btn btn-primary" href="/projects/new">
		<img src="/static/icons/add.svg" width="16" height="16" alt="" class="icon icon-invert"/>
		New project
	</a>
}

templ NewPage(c web.Chrome, options []AssetOption, conditions []settings.Classifier, preselectedAssetID string) {
	@web.AppLayout("New project", c, newBody(options, conditions, preselectedAssetID, c.Locale))
}

templ newBody(options []AssetOption, conditions []settings.Classifier, preselectedAssetID string, locale i18n.Locale) {
	@web.PageHeader("New project", "", templ.NopComponent)
	@web.Card() {
		<form method="post" action="/projects" enctype="multipart/form-data" class="form-grid">
			@web.Field("Asset", "") {
				<select class="input" name="assetId" required>
					<option value="" disabled selected?={ preselectedAssetID == "" }>Select an asset…</option>
					for _, a := range options {
						<option value={ a.ID } selected?={ a.ID == preselectedAssetID }>{ assetOptionLabel(a) }</option>
					}
				</select>
			}
			@web.Field("Title", "e.g. \"Cleaning and varnish removal\"") {
				<input class="input" name="title" required/>
			}
			<div class="form-section">
				<p class="form-section-title">Initial assessment <span class="page-subtitle">(optional)</span></p>
				@web.Field("Condition", "") {
					@web.ClassifierAutocomplete("assessmentCondition", "condition_state", "code", "", "Select…", settings.ClassifierAutocompleteOptions(conditions, locale))
				}
				@web.Field("Description", "") {
					<textarea class="input" name="assessmentDescription" rows="2" placeholder="Condition on arrival…"></textarea>
				}
				@web.FileInput("photos", "Photos", "On a phone this opens your camera directly.")
			</div>
			<button type="submit" class="btn btn-primary">
				<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon icon-invert"/>
				Create
			</button>
		</form>
	}
	<script src="/static/js/classifier-autocomplete.js" defer></script>
}

func assetOptionLabel(a AssetOption) string {
	name := a.ReferenceCode
	if a.Title.Valid && a.Title.String != "" {
		name = a.Title.String
	}
	return name + " — " + a.ClientName
}

// DetailPage is the Project hub: stage/priority overview, the Finish-project action, and
// Assessments/Treatments/Reports/Media sections scoped to this Project — same "linked-record
// hub" pattern internal/assets' DetailPage uses.
templ DetailPage(c web.Chrome, project Project, asset *assets.Asset, client *clients.Client, stages []settings.Classifier, assignedToName string,
	projectAssessments []assessments.ListRow, conditions []settings.Classifier,
	projectTreatments []treatments.ListRow, treatmentMethodLabels map[string]string, treatmentMethods []settings.Classifier,
	projectReports []reporter.ListRow, projectMedia []media.ReferenceWithMedia, damageMappingCount int) {
	@web.AppLayout(project.Title, c, detailBody(project, asset, client, stages, assignedToName,
		projectAssessments, conditions, projectTreatments, treatmentMethodLabels, treatmentMethods,
		projectReports, projectMedia, damageMappingCount, c.Locale))
}

templ detailBody(project Project, asset *assets.Asset, client *clients.Client, stages []settings.Classifier, assignedToName string,
	projectAssessments []assessments.ListRow, conditions []settings.Classifier,
	projectTreatments []treatments.ListRow, treatmentMethodLabels map[string]string, treatmentMethods []settings.Classifier,
	projectReports []reporter.ListRow, projectMedia []media.ReferenceWithMedia, damageMappingCount int, locale i18n.Locale) {
	@web.PageHeader(project.Title, "", detailActions(project, asset))
	<p class="page-subtitle">
		if asset != nil {
			<a href={ templ.URL("/assets/" + asset.ID) }>{ asset.DisplayName() }</a>
		}
		if client != nil {
			· owner: <a href={ templ.URL("/clients/" + client.ID) }>{ client.Name }</a>
		}
	</p>
	<div class="report-layout">
		<div class="report-layout-main">
			@web.Card() {
				<dl class="detail-dl">
					@detailField("Stage", stageTitle(stages, project.Stage, locale))
					@detailField("Priority", project.Priority)
					@detailField("Assigned to", assignedToName)
				</dl>
				if project.Stage != "completed" {
					<form method="post" action={ templ.URL("/projects/" + project.ID + "/stage") } class="inline-edit-form">
						@web.Field("Move to stage", "") {
							<select class="input" name="stage">
								for _, stage := range stages {
									if stage.Code != "completed" {
										<option value={ stage.Code } selected?={ stage.Code == project.Stage }>{ settings.ClassifierLabel(stage, locale) }</option>
									}
								}
							</select>
						}
						<button type="submit" class="btn btn-secondary">
							<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon"/>
							Update stage
						</button>
					</form>
					<form method="post" action={ templ.URL("/projects/" + project.ID + "/finish") } class="form-section" data-confirm="Finish this project? If it has no report yet, one will be drafted automatically for you to review.">
						<button type="submit" class="btn btn-primary">
							<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon icon-invert"/>
							Finish project
						</button>
					</form>
				} else {
					@web.OpenBadge(true)
				}
			}
			@web.Card() {
				<div class="card-header-row">
					<h2 class="dashboard-heading">Assessments</h2>
					@web.ModalTrigger("modal-assessment", "Add")
				</div>
				if len(projectAssessments) == 0 {
					<p class="empty-state">No assessments recorded yet.</p>
				}
				<ul class="entity-list">
					for _, a := range projectAssessments {
						<li class="entity-list-row">
							<a href={ templ.URL("/assessments/" + a.ID) } class="entity-list-name">{ conditionTitle(conditions, a.Condition, locale) }</a>
							<div class="row-actions">
								<span class="page-subtitle">{ a.RecordedAt.Format("2006-01-02") }</span>
								<a href={ templ.URL("/assessments/" + a.ID) } class="row-action-icon" title="View">
									<img src="/static/icons/chevron-right.svg" width="14" height="14" alt=""/>
								</a>
							</div>
						</li>
					}
				</ul>
				@web.Modal("modal-assessment", "Add: Assessment") {
					@assessments.AddModalBody(project.ID, nil, conditions, locale)
				}
			}
			@web.Card() {
				<div class="card-header-row">
					<h2 class="dashboard-heading">Treatments</h2>
					@web.ModalTrigger("modal-treatment", "Add")
				</div>
				if len(projectTreatments) == 0 {
					<p class="empty-state">No treatments logged yet.</p>
				}
				<ul class="entity-list">
					for _, t := range projectTreatments {
						<li class="entity-list-row">
							<a href={ templ.URL("/treatments/" + t.ID) } class="entity-list-name">{ t.Title }</a>
							<div class="row-actions">
								<span class="badge">{ treatmentMethodLabel(treatmentMethodLabels, t.Method) }</span>
								<span class="page-subtitle">{ t.PerformedAt.Format("2006-01-02") }</span>
								<a href={ templ.URL("/treatments/" + t.ID) } class="row-action-icon" title="View">
									<img src="/static/icons/chevron-right.svg" width="14" height="14" alt=""/>
								</a>
							</div>
						</li>
					}
				</ul>
				@web.Modal("modal-treatment", "Add: Treatments") {
					@treatments.AddModalBody(project.ID, nil, treatmentMethods, locale)
				}
			}
			@web.Card() {
				<div class="card-header-row">
					<h2 class="dashboard-heading">Reports</h2>
					@web.ModalTrigger("modal-report", "Add")
				</div>
				if len(projectReports) == 0 {
					<p class="empty-state">No reports yet for this project.</p>
				}
				<ul class="entity-list">
					for _, rep := range projectReports {
						<li class="entity-list-row">
							<a href={ templ.URL("/reports/" + rep.ID) } class="entity-list-name">{ rep.Title }</a>
							<div class="row-actions">
								if rep.Status == "final" {
									<span class="badge badge-green">Final</span>
								} else {
									<span class="badge badge-amber">Draft</span>
								}
								<a href={ templ.URL("/reports/" + rep.ID) } class="row-action-icon" title="View">
									<img src="/static/icons/chevron-right.svg" width="14" height="14" alt=""/>
								</a>
							</div>
						</li>
					}
				</ul>
				@web.Modal("modal-report", "Add: Reports") {
					@reporter.AddModalBody(project.ID, nil)
				}
			}
			@web.Card() {
				<div class="card-header-row">
					<h2 class="dashboard-heading">Media</h2>
					@web.ModalTrigger("modal-media", "Add")
				</div>
				<p class="page-subtitle">{ strconv.Itoa(damageMappingCount) } damage mapping(s) marked across this project's media.</p>
				if len(projectMedia) == 0 {
					<p class="empty-state">No media yet.</p>
				}
				<ul class="entity-list">
					for _, ref := range projectMedia {
						<li class="entity-list-row">
							<a href={ mediaViewHref(ref) } class="entity-list-name">
								<img class="entity-thumb" src={ "/api/media/" + ref.MediaID } alt="" style="width:2.5rem;height:2.5rem;display:inline-block;vertical-align:middle;margin-right:0.5rem;border-radius:4px;"/>
								if ref.Role.Valid {
									{ ref.Role.String }
								} else {
									{ string(ref.Media.Kind) }
								}
							</a>
							<div class="row-actions">
								<a href={ mediaViewHref(ref) } class="row-action-icon" title="View">
									<img src="/static/icons/chevron-right.svg" width="14" height="14" alt=""/>
								</a>
								<form method="post" action={ templ.URL("/projects/" + project.ID + "/media/" + ref.ID + "/unlink") } data-confirm="Unlink this media item? It stays in the database but won't show here anymore.">
									<button type="submit" class="row-action-icon" title="Unlink">
										<img src="/static/icons/close.svg" width="14" height="14" alt=""/>
									</button>
								</form>
							</div>
						</li>
					}
				</ul>
				@web.Modal("modal-media", "Add: Media") {
					<form method="post" action={ templ.URL("/projects/" + project.ID + "/media") } enctype="multipart/form-data" class="form-grid">
						@web.FileInput("photos", "Photos / video", "On a phone this opens your camera directly.")
						<button type="submit" class="btn btn-primary">
							<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon icon-invert"/>
							Upload
						</button>
					</form>
				}
			}
		</div>
	</div>
	<script src="/static/js/modal.js" defer></script>
	<script src="/static/js/confirm.js" defer></script>
}

func mediaViewHref(ref media.ReferenceWithMedia) templ.SafeURL {
	if ref.Media.Kind == media.KindVideo {
		return templ.URL("/api/media/" + ref.MediaID + "?variant=original")
	}
	return templ.URL("/media/view/" + ref.MediaID)
}

func conditionTitle(conditions []settings.Classifier, code string, locale i18n.Locale) string {
	for _, c := range conditions {
		if c.Code == code {
			return settings.ClassifierLabel(c, locale)
		}
	}
	return code
}

func treatmentMethodLabel(labels map[string]string, code string) string {
	if label, ok := labels[code]; ok {
		return label
	}
	return code
}

templ detailField(label, value string) {
	<div>
		<dt class="detail-dt">{ label }</dt>
		<dd class="detail-dd">
			if value == "" {
				—
			} else {
				{ value }
			}
		</dd>
	</div>
}

func stageTitle(stages []settings.Classifier, code string, locale i18n.Locale) string {
	for _, s := range stages {
		if s.Code == code {
			return settings.ClassifierLabel(s, locale)
		}
	}
	return code
}

templ detailActions(project Project, asset *assets.Asset) {
	if asset != nil {
		<a class="btn btn-ghost" href={ templ.URL("/assets/" + asset.ID) }>
			<img src="/static/icons/chevron-right.svg" width="14" height="14" alt="" class="icon"/>
			View asset
		</a>
	}
	<a class="btn btn-secondary" href={ templ.URL("/projects/" + project.ID + "/edit") }>
		<img src="/static/icons/edit.svg" width="14" height="14" alt="" class="icon"/>
		Edit
	</a>
	<form method="post" action={ templ.URL("/projects/" + project.ID + "/unlink") } data-confirm={ "Unlink \"" + project.Title + "\"? It stays in the database but won't show here anymore." }>
		<button type="submit" class="btn btn-ghost">
			<img src="/static/icons/close.svg" width="14" height="14" alt="" class="icon"/>
			Unlink
		</button>
	</form>
	@web.ExportLinks("project", project.ID)
}

templ EditPage(c web.Chrome, project Project) {
	@web.AppLayout("Edit "+project.Title, c, editBody(project))
}

templ editBody(project Project) {
	@web.PageHeader("Edit "+project.Title, "", templ.NopComponent)
	@web.Card() {
		<form method="post" action={ templ.URL("/projects/" + project.ID + "/update") } class="form-grid">
			@web.Field("Title", "") {
				<input class="input" name="title" required value={ project.Title }/>
			}
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">
					<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon icon-invert"/>
					Save
				</button>
				<a class="btn btn-ghost" href={ templ.URL("/projects/" + project.ID) }>
					<img src="/static/icons/close.svg" width="14" height="14" alt="" class="icon"/>
					Cancel
				</a>
			</div>
		</form>
	}
}

