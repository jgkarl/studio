package web

import "strconv"

// Icon renders one Material Symbols (Outlined) glyph at the given pixel size - the Google Fonts
// CDN link in Layout/AuthLayout/AppLayout's <head> is what actually loads the font (see
// static/css/app.css's .material-symbols-outlined). Sized via font-size and colored via
// currentColor, so a button's own text color already themes the icon correctly on any
// background/theme - callers never need a separate "inverted" variant the way the old hand-drawn
// static/icons/*.svg set did.
templ Icon(name string, size int) {
	<span class="material-symbols-outlined icon" style={ "font-size:" + strconv.Itoa(size) + "px" } aria-hidden="true">{ name }</span>
}

// TableRowChips wraps a "simple table" row's always-visible info badges/chips (status, method,
// date, ...) - see TableRowActions below for the row's interactive buttons, which get a different
// (collapsible-on-mobile) treatment. Together these are what every "linked records" list - a
// Project's Assessments/Treatments/Reports/Media, an Asset's per-project sub-lists, a Client's
// Assets, ... - uses instead of the module search-result pages' own card-row look, which those
// don't share (no [data-el-root] search/filter/striping machinery here, just <title-label>,
// <chips>, <actions> on a plain divider-line row).
templ TableRowChips() {
	<span class="row-chips">
		{ children... }
	</span>
}

// TableRowActions renders a row's interactive actions (View/Edit/Remove/...) twice - once inline
// (visible from sm up) and once inside a "⋮" kebab menu (visible below sm) - from the exact same
// markup, so callers never write their action buttons more than once. CSS toggles which copy is
// visible per breakpoint; no JS needed, same <details>/<summary> disclosure as .split-btn's own
// "more options" caret. A row with only one action still works fine collapsed into a one-item
// menu - simpler than special-casing "just show it inline always" for that case.
templ TableRowActions() {
	<span class="row-actions-inline">
		{ children... }
	</span>
	<details class="row-actions-menu">
		<summary class="row-action-icon" aria-label="More actions" title="More actions">
			@Icon("more_vert", 18)
		</summary>
		<div class="row-actions-menu-panel">
			{ children... }
		</div>
	</details>
}

// Card and Field are the two truly reusable structural wrappers (spacing/borders are easy to get
// inconsistent by hand). Buttons/inputs/badges are plain HTML with the .btn/.input/.badge
// utility classes from static/css/app.css directly in each page's markup — simple templates, no
// component layer mirroring every HTML element.
templ Card() {
	<div class="card">
		{ children... }
	</div>
}

templ Field(label string, hint string) {
	<div class="field">
		<label>{ label }</label>
		{ children... }
		if hint != "" {
			<span class="hint">{ hint }</span>
		}
	</div>
}

// FileInput replaces a raw <input type="file"> with a styled "Choose files…" trigger — the
// native input stays functional (multi-select, camera capture on mobile) but visually hidden;
// clicking the label opens its file picker natively, no JS required. An optional "Name / caption"
// text field sits alongside it, submitted as name+"Caption" - the handler on the other end threads
// it through to media.Service's *WithCaption upload methods (applied to every file in the batch,
// a multi-file <input> having no way to solicit one caption per file), so a name can be given
// right here at upload time instead of only ever after, editing each item separately once
// uploaded. Every module's upload flow (New asset's cover photo, a Project's initial photos, an
// Asset/Project/Report's "Add media" modal, ...) uses this one component, so browse-name-save
// works the same way everywhere.
templ FileInput(name, label, hint string) {
	@Field(label, hint) {
		<div class="file-input-row">
			<input type="file" id={ name + "-input" } name={ name } multiple accept="image/*,video/*" capture="environment" class="sr-only"/>
			<label for={ name + "-input" } class="btn btn-secondary">
				@Icon("upload", 14)
				Choose files…
			</label>
			<input type="text" class="input" name={ name + "Caption" } placeholder="Name / caption (optional)"/>
		</div>
	}
}

templ Alert(tone string) {
	<p class={ "alert", templ.KV("alert-error", tone == "error"), templ.KV("alert-success", tone == "success") }>
		{ children... }
	</p>
}

// ExportLinks renders the "Export HTML" / "Export PDF" action pair for a detail page — exportType
// is one of "asset", "project", "report" (internal/export.Type), matching the
// /api/export/{type}/{id} route.
templ ExportLinks(exportType, id string) {
	<a class="btn btn-ghost" href={ templ.URL("/api/export/" + exportType + "/" + id + "?format=html") }>
		@Icon("download", 14)
		HTML
	</a>
	<a class="btn btn-ghost" href={ templ.URL("/api/export/" + exportType + "/" + id + "?format=pdf") }>
		@Icon("download", 14)
		PDF
	</a>
}

// OpenBadge renders the small tone badge used everywhere a Project's open/closed status shows up
// (Asset detail workflow lists, Workflows list/detail) - "Open" while completedAt is unset,
// "Completed" once it's been marked done.
templ OpenBadge(completed bool) {
	if completed {
		<span class="badge badge-green">Completed</span>
	} else {
		<span class="badge badge-amber">Open</span>
	}
}

// ModalTrigger renders the "+ Add" button that opens the named Modal (see Modal below) — id must
// match the modalID passed to that Modal. label defaults to "+ Add" when empty.
templ ModalTrigger(modalID, label string) {
	<button type="button" class="btn btn-secondary" data-modal-open={ modalID }>
		@Icon("add", 14)
		if label != "" {
			{ label }
		} else {
			+ Add
		}
	</button>
}

// Modal is the generic "+Add" dialog body — static/js/modal.js drives open/close via
// data-modal-open/data-modal-close (see that file's doc comment for the full markup contract).
// Pages using this must include modal.js once (see e.g. internal/assets/views.templ detailBody).
templ Modal(modalID, title string) {
	<div id={ modalID } class="modal-overlay" hidden>
		<div class="modal-panel">
			<button type="button" class="modal-close" data-modal-close aria-label="Close">
				@Icon("close", 16)
			</button>
			if title != "" {
				<h2 class="modal-panel-title">{ title }</h2>
			}
			{ children... }
		</div>
	</div>
}

// FilterOption is one <option> for EntityListFilterSelect/EntityListGroupBySelect.
type FilterOption struct {
	Value string
	Label string
}

// EntityListSearchInput renders the search text input static/js/entity-list-filter.js reads via
// [data-el-search]. Place inside a toolbar div carrying [data-el-root] alongside a
// <ul data-el-list> of [data-el-row] items — see that file's doc comment for the full markup
// contract.
templ EntityListSearchInput(placeholder string) {
	<span class="search-wrap">
		@Icon("search", 16)
		<input type="text" data-el-search placeholder={ placeholder }/>
	</span>
}

// EntityListFilterSelect renders one filter <select data-el-filter="key">. Each option's Value
// must match the corresponding row's data-el-<key-hyphenated> attribute exactly (e.g. key
// "assetType" matches data-el-asset-type). The funnel icon is purely visual (matching
// EntityListSearchInput's own leading icon) - it's what "All types"/"All conditions" reads as a
// filter rather than a plain picklist at a glance, especially once the label itself has less room
// on a narrow screen.
templ EntityListFilterSelect(key, allLabel string, options []FilterOption) {
	<label class="filter-chip">
		@Icon("filter_alt", 14)
		<select class="filter-chip-select" data-el-filter={ key }>
			<option value="">{ allLabel }</option>
			for _, opt := range options {
				<option value={ opt.Value }>{ opt.Label }</option>
			}
		</select>
	</label>
}

// EntityListGroupBySelect renders the "Group by" <select data-el-groupby>. Each option's Value
// must match the corresponding row's data-el-group-<value-hyphenated> attribute exactly.
templ EntityListGroupBySelect(options []FilterOption) {
	<label class="filter-chip">
		@Icon("filter_alt", 14)
		<select class="filter-chip-select" data-el-groupby>
			<option value="">No grouping</option>
			for _, opt := range options {
				<option value={ opt.Value }>Group by { opt.Label }</option>
			}
		</select>
	</label>
}

// ClassifierOption is one entry a ClassifierAutocomplete's <datalist> can match against.
type ClassifierOption struct {
	ID    string
	Code  string
	Title string
}

// ClassifierAutocomplete replaces a classifier-bound <select> with a type-ahead text field: typing
// a value already in options matches it (case-insensitively, resolved client-side by
// static/js/classifier-autocomplete.js); typing something new creates that classifier on blur via
// POST /settings/classifiers/{type}/find-or-create and selects the new row — no trip to Settings
// required first. valueKey is "id" or "code", matching whichever the target field stores (most
// foreign keys store the classifier id; a few historic fields — Assessment.condition,
// Project.stage-adjacent fields — store the classifier's code string directly).
templ ClassifierAutocomplete(name, classifierType, valueKey, selected, placeholder string, options []ClassifierOption) {
	<div class="classifier-autocomplete" data-classifier-autocomplete data-classifier-type={ classifierType } data-value-key={ valueKey }>
		<input type="hidden" name={ name } value={ selected } data-ca-value/>
		<input type="text" class="input" list={ name + "-options" } placeholder={ placeholder }
			value={ selectedLabelFor(options, valueKey, selected) } data-ca-text/>
		<datalist id={ name + "-options" } data-ca-options>
			for _, opt := range options {
				<option value={ opt.Title } data-id={ opt.ID } data-code={ opt.Code }></option>
			}
		</datalist>
	</div>
}

func selectedLabelFor(options []ClassifierOption, valueKey, selected string) string {
	for _, opt := range options {
		if (valueKey == "code" && opt.Code == selected) || (valueKey != "code" && opt.ID == selected) {
			return opt.Title
		}
	}
	return ""
}

// PageHeader is the top-of-page title/subtitle/actions block every in-app module list/detail page
// uses. actions is a slot for buttons/links — pass templ.NopComponent when there are none. Title
// and actions always share their own row (.page-header-row, flex-wrap:nowrap, vertically
// centered) at every breakpoint, down to a smaller h1 on a narrow screen rather than ever wrapping
// the primary action underneath; subtitle (when present) is its own row below that pair, not
// stacked inside the same flex item as the title, so centering the title/actions row against just
// the title's own height (not title+subtitle combined) actually lines them up.
templ PageHeader(title, subtitle string, actions templ.Component) {
	<div class="page-header">
		<div class="page-header-row">
			<h1>{ title }</h1>
			<div class="actions">
				@actions
			</div>
		</div>
		if subtitle != "" {
			<p class="page-subtitle">{ subtitle }</p>
		}
	</div>
}

// NewActionLink is the "+ New" primary button every module list page's PageHeader actions slot
// uses (New client/asset/treatment/.../New intake on the dashboard) - one shared component instead
// of six near-identical copies. label carries the full "New client"/"New asset"/... wording only
// for aria-label/title (a screen reader or tooltip still gets the specific noun); the visible text
// is always the plain "New" - the model name is redundant next to a page titled "Clients" - and
// collapses to icon-only under .btn-label's narrow-screen rule (static/css/app.css) so the button
// never forces PageHeader's title+action row to wrap on a small screen.
templ NewActionLink(href, label string) {
	<a class="btn btn-primary" href={ templ.URL(href) } aria-label={ label } title={ label }>
		@Icon("add", 16)
		<span class="btn-label">New</span>
	</a>
}
