// Package web holds cross-cutting presentation: the shared page layout, small reusable templ UI
// components (ui.templ, added alongside the first module that needs them), and HTTP middleware.
package web

templ Layout(title string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Studio</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block"/>
			<link rel="stylesheet" href="/static/css/app.css"/>
		</head>
		<body>
			<main class="container">
				@body
			</main>
			<script src="/static/js/confirm.js" defer></script>
		</body>
	</html>
}

// AuthLayout is the same page shell as Layout but wraps content in the narrower, centered
// .auth-shell container instead of the full 1200px .container — used by login/register/
// forgot-reset-password/verify-email, none of which need the wide in-app layout.
templ AuthLayout(title string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Studio</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block"/>
			<link rel="stylesheet" href="/static/css/app.css"/>
		</head>
		<body>
			<div class="auth-shell">
				@body
			</div>
		</body>
	</html>
}

templ Placeholder(message string) {
	<div class="card">
		<h1>Studio</h1>
		<p class="page-subtitle">{ message }</p>
	</div>
}
