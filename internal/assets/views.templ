package assets

import (
	"database/sql"
	"strconv"

	"studio/internal/assessments"
	"studio/internal/clients"
	"studio/internal/i18n"
	"studio/internal/media"
	"studio/internal/reporter"
	"studio/internal/settings"
	"studio/internal/treatments"
	"studio/internal/web"
)

templ ListPage(c web.Chrome, rows []ListRow, assetTypes []settings.Classifier, conditions []settings.Classifier, locale i18n.Locale) {
	@web.AppLayout("Assets", c, listBody(rows, assetTypes, conditions, locale))
}

templ listBody(rows []ListRow, assetTypes []settings.Classifier, conditions []settings.Classifier, locale i18n.Locale) {
	@web.PageHeader("Assets", "The physical objects being conserved.", web.NewActionLink("/assets/new", "New asset"))
	<div data-el-root>
		<div class="list-toolbar">
			@web.EntityListSearchInput("Search by title, artist, reference code…")
			@web.EntityListFilterSelect("assetType", "All types", settings.ClassifierFilterOptions(assetTypes, locale))
			@web.EntityListFilterSelect("condition", "All conditions", settings.ClassifierFilterOptions(conditions, locale))
			@web.EntityListGroupBySelect([]web.FilterOption{
				{Value: "client", Label: "Client"},
				{Value: "assetType", Label: "Type"},
				{Value: "condition", Label: "Condition"},
			})
		</div>
		if len(rows) == 0 {
			<p class="empty-state">No assets yet.</p>
		}
		<ul class="entity-list" data-el-list>
			for _, row := range rows {
				<li
					data-el-row
					data-el-search={ assetSearchHaystack(row) }
					data-el-asset-type={ row.AssetTypeCode }
					data-el-condition={ row.CurrentStateCondition.String }
					data-el-group-client={ row.ClientName }
					data-el-group-asset-type={ row.AssetTypeTitle }
					data-el-group-condition={ row.CurrentStateCondition.String }
				>
					<a href={ templ.URL("/assets/" + row.ID) } class="entity-list-row">
						@assetThumb(row)
						<div>
							<span class="entity-list-name">
								if row.Title.Valid {
									{ row.Title.String }
								} else {
									{ row.ReferenceCode }
								}
							</span>
							<div class="page-subtitle">{ row.ReferenceCode } · owner: { row.ClientName }</div>
						</div>
						<div class="row-actions">
							<span class="badge tag-chip" data-el-tag-filter="assetType" data-el-tag-value={ row.AssetTypeCode } role="button" tabindex="0">{ row.AssetTypeTitle }</span>
							if row.CurrentStateCondition.Valid {
								<span class="badge badge-amber tag-chip" data-el-tag-filter="condition" data-el-tag-value={ row.CurrentStateCondition.String } role="button" tabindex="0">{ row.CurrentStateCondition.String }</span>
							}
							<span class="page-subtitle">{ strconv.Itoa(row.ProjectCount) } workflow(s)</span>
						</div>
						<span class="material-symbols-outlined icon entity-list-chevron" style="font-size:16px" aria-hidden="true">chevron_right</span>
					</a>
				</li>
			}
		</ul>
	</div>
	<script src="/static/js/entity-list-filter.js" defer></script>
}

templ assetThumb(row ListRow) {
	if row.ThumbnailMediaID.Valid {
		<img class="entity-thumb" src={ "/api/media/" + row.ThumbnailMediaID.String } alt=""/>
	} else {
		<span class="entity-thumb entity-thumb-placeholder">{ row.AssetTypeTitle }</span>
	}
}

func assetSearchHaystack(row ListRow) string {
	title := row.ReferenceCode
	if row.Title.Valid {
		title = row.Title.String
	}
	return title + " " + row.ReferenceCode + " " + row.AssetTypeTitle + " " + row.ClientName
}

templ NewPage(c web.Chrome, allClients []clients.Client, assetTypes []settings.Classifier, preselectedClientID string) {
	@web.AppLayout("New asset", c, newBody(allClients, assetTypes, preselectedClientID, c.Locale))
}

templ newBody(allClients []clients.Client, assetTypes []settings.Classifier, preselectedClientID string, locale i18n.Locale) {
	@web.PageHeader("New asset", "", templ.NopComponent)
	@web.Card() {
		<form method="post" action="/assets" class="form-grid">
			<div class="form-row-2">
				@web.Field("Client", "") {
					<select class="input" name="clientId" required>
						<option value="" disabled selected?={ preselectedClientID == "" }>Select a client…</option>
						for _, cl := range allClients {
							<option value={ cl.ID } selected?={ cl.ID == preselectedClientID }>{ cl.Name }</option>
						}
					</select>
				}
				@web.Field("Asset type", "") {
					@web.ClassifierAutocomplete("assetTypeId", "asset_type", "id", "", "Select a type…", settings.ClassifierAutocompleteOptions(assetTypes, locale))
				}
			</div>
			@web.Field("Reference code", "unique identifier for this asset") {
				<input class="input" name="referenceCode" required placeholder="e.g. 2026-014"/>
			}
			<div class="form-row-2">
				@web.Field("Title", "") {
					<input class="input" name="title" placeholder="Untitled"/>
				}
				@web.Field("Artist", "") {
					<input class="input" name="artist"/>
				}
			</div>
			<div class="form-row-2">
				@web.Field("Creation period", "") {
					<input class="input" name="creationPeriod" placeholder="c. 1920"/>
				}
				@web.Field("Dimensions", "") {
					<input class="input" name="dimensions" placeholder="60cm x 80cm"/>
				}
			</div>
			<div class="form-row-2">
				@web.Field("Medium", "") {
					<input class="input" name="medium"/>
				}
				@web.Field("Weight", "") {
					<input class="input" name="weight" placeholder="e.g. 4.2 kg"/>
				}
			</div>
			@web.Field("Description", "") {
				<textarea class="input" name="description" rows="2"></textarea>
			}
			@web.Field("Signature / marks", "") {
				<input class="input" name="signatureMarks" placeholder="e.g. Signed lower right, illegible"/>
			}
			@web.Field("Provenance", "") {
				<textarea class="input" name="provenance" rows="2"></textarea>
			}
			<div class="form-row-3">
				@web.Field("Acquisition date", "") {
					<input class="input" type="date" name="acquisitionDate"/>
				}
				@web.Field("Estimated value", "") {
					<input class="input" type="number" step="0.01" name="estimatedValue"/>
				}
				@web.Field("Insured", "") {
					<select class="input" name="isInsured">
						<option value="">Unknown</option>
						<option value="true">Yes</option>
						<option value="false">No</option>
					</select>
				}
			</div>
			@web.Field("Location in studio", "") {
				<input class="input" name="locationInStudio" placeholder="e.g. Shelf B3, Wet Room"/>
			}
			<p class="hint">Next you'll start this asset's first project — that's where its intake condition gets recorded.</p>
			<button type="submit" class="btn btn-primary">Create asset</button>
		</form>
	}
	<script src="/static/js/classifier-autocomplete.js" defer></script>
}

templ DetailPage(c web.Chrome, asset Asset, client *clients.Client, assetType *settings.Classifier,
	projectCards []ProjectCard, assessmentProjects []assessments.ProjectOption,
	conditions []settings.Classifier, reportProjects []reporter.ProjectOption,
	treatmentProjects []treatments.ProjectOption, treatmentMethodLabels map[string]string,
	treatmentMethods []settings.Classifier, stageLabels map[string]string, assetMedia []media.ReferenceWithMedia) {
	@web.AppLayout(asset.DisplayName(), c, detailBody(asset, client, assetType, projectCards, assessmentProjects,
		conditions, reportProjects, treatmentProjects, treatmentMethodLabels, treatmentMethods,
		stageLabels, assetMedia, c.Locale))
}

templ detailBody(asset Asset, client *clients.Client, assetType *settings.Classifier,
	projectCards []ProjectCard, assessmentProjects []assessments.ProjectOption,
	conditions []settings.Classifier, reportProjects []reporter.ProjectOption,
	treatmentProjects []treatments.ProjectOption, treatmentMethodLabels map[string]string,
	treatmentMethods []settings.Classifier, stageLabels map[string]string, assetMedia []media.ReferenceWithMedia, locale i18n.Locale) {
	@web.PageHeader(asset.DisplayName(), asset.ReferenceCode+" · "+assetTypeTitle(assetType, locale), assetActions(asset))
	if client != nil {
		<p class="page-subtitle" style="margin-top:-0.75rem;margin-bottom:1rem;">
			Owner: <a href={ templ.URL("/clients/" + client.ID) }>{ client.Name }</a>
		</p>
	}
	@web.Card() {
		<h2 class="dashboard-heading">Details</h2>
		<dl class="detail-dl">
			@detailField("Artist", asset.Artist.String)
			@detailField("Creation period", asset.CreationPeriod.String)
			@detailField("Dimensions", asset.Dimensions.String)
			@detailField("Medium", asset.Medium.String)
			@detailField("Weight", asset.Weight.String)
			@detailField("Signature / marks", asset.SignatureMarks.String)
			@detailField("Location in studio", asset.LocationInStudio.String)
			@detailField("Insured", insuredLabel(asset.IsInsured))
			@detailField("Estimated value", estimatedValueLabel(asset.EstimatedValue))
			@detailField("Acquisition date", acquisitionDateLabel(asset.AcquisitionDate))
		</dl>
		if asset.Description.Valid {
			<p class="detail-paragraph">{ asset.Description.String }</p>
		}
		if asset.Provenance.Valid {
			<p class="detail-paragraph"><strong>Provenance:</strong> { asset.Provenance.String }</p>
		}
	}
	<div class="detail-section">
		<div class="card-header-row">
			<h2 class="dashboard-heading">Projects</h2>
			<div class="row-actions">
				if len(assessmentProjects) > 0 {
					@web.ModalTrigger("modal-assessment", "Assessment")
				}
				if len(treatmentProjects) > 0 {
					@web.ModalTrigger("modal-treatment", "Treatment")
				}
				if len(reportProjects) > 0 {
					@web.ModalTrigger("modal-report", "Report")
				}
				@web.ModalTrigger("modal-project", "Project")
			</div>
		</div>
		if len(projectCards) == 0 {
			<p class="empty-state">No projects yet.</p>
		}
		for _, pc := range projectCards {
			@assetProjectCard(pc, conditions, treatmentMethodLabels, stageLabels, locale)
		}
	</div>
	@web.Card() {
		<div class="card-header-row">
			<h2 class="dashboard-heading">Media</h2>
			@web.ModalTrigger("modal-media", "Add")
		</div>
		if len(assetMedia) == 0 {
			<p class="empty-state">No media yet.</p>
		}
		<ul class="entity-list">
			for _, ref := range assetMedia {
				<li class="entity-list-row">
					<a href={ mediaViewHref(ref) } class="entity-list-name">
						<img class="entity-thumb" src={ "/api/media/" + ref.MediaID } alt="" style="width:2.5rem;height:2.5rem;display:inline-block;vertical-align:middle;margin-right:0.5rem;border-radius:4px;"/>
						if ref.Role.Valid {
							{ ref.Role.String }
						} else {
							{ string(ref.Media.Kind) }
						}
					</a>
					<div class="row-actions">
						<a href={ mediaViewHref(ref) } class="row-action-icon" title="View">
							@web.Icon("chevron_right", 14)
						</a>
						<form method="post" action={ templ.URL("/assets/" + asset.ID + "/media/" + ref.ID + "/unlink") } data-confirm="Unlink this media item? It stays in the database but won't show here anymore.">
							<button type="submit" class="row-action-icon" title="Unlink">
								@web.Icon("close", 14)
							</button>
						</form>
					</div>
				</li>
			}
		</ul>
		@web.Modal("modal-media", "Add: Media") {
			<form method="post" action={ templ.URL("/assets/" + asset.ID + "/media") } enctype="multipart/form-data" class="form-grid">
				@web.FileInput("photos", "Photos / video", "On a phone this opens your camera directly.")
				<button type="submit" class="btn btn-primary">
					@web.Icon("check_circle", 14)
					Upload
				</button>
			</form>
		}
	}
	if len(assessmentProjects) > 0 {
		@web.Modal("modal-assessment", "Add: Assessment") {
			@assessments.AddModalBody("", assessmentProjects, conditions, locale)
		}
	}
	if len(treatmentProjects) > 0 {
		@web.Modal("modal-treatment", "Add: Treatments") {
			@treatments.AddModalBody("", treatmentProjects, treatmentMethods, locale)
		}
	}
	if len(reportProjects) > 0 {
		@web.Modal("modal-report", "Add: Reports") {
			@reporter.AddModalBody("", reportProjects)
		}
	}
	@web.Modal("modal-project", "Add: Projects") {
		<form method="post" action="/projects" enctype="multipart/form-data" class="form-grid">
			<input type="hidden" name="assetId" value={ asset.ID }/>
			@web.Field("Title", "e.g. \"Cleaning and varnish removal\"") {
				<input class="input" name="title" required/>
			}
			<button type="submit" class="btn btn-primary">
				@web.Icon("check_circle", 14)
				Create
			</button>
		</form>
	}
	<script src="/static/js/modal.js" defer></script>
}

func stageLabel(labels map[string]string, code string) string {
	if label, ok := labels[code]; ok {
		return label
	}
	return code
}

// assetProjectCard is one Project's card in the Asset detail page's Projects section — the
// project itself plus its own Assessments/Treatments/Reports nested inside, mirroring
// internal/dashboard's projectCardView/projectCardSection shape (same .dashboard-project-card/
// .dashboard-project-card-heading classes) but keeping this page's richer per-row actions
// (view/edit/unlink icons) rather than the dashboard's plainer read-only rows.
templ assetProjectCard(pc ProjectCard, conditions []settings.Classifier, treatmentMethodLabels map[string]string, stageLabels map[string]string, locale i18n.Locale) {
	<div class="card dashboard-project-card">
		<div class="card-header-row">
			<a href={ templ.URL("/projects/" + pc.Project.ID) } class="entity-list-name">{ pc.Project.Title }</a>
			<div class="row-actions">
				@web.OpenBadge(pc.Project.Stage == "completed")
				<a href={ templ.URL("/projects/" + pc.Project.ID + "/edit") } class="row-action-icon" title="Edit">
					@web.Icon("edit", 14)
				</a>
				<form method="post" action={ templ.URL("/projects/" + pc.Project.ID + "/unlink") } data-confirm={ "Unlink \"" + pc.Project.Title + "\"? It stays in the database but won't show here anymore." }>
					<button type="submit" class="row-action-icon" title="Unlink">
						@web.Icon("close", 14)
					</button>
				</form>
			</div>
		</div>
		<div class="page-subtitle">{ stageLabel(stageLabels, pc.Project.Stage) }</div>
		@assetProjectCardSection("Assessments", "No assessments recorded yet.", len(pc.Assessments))
		<ul class="entity-list">
			for _, a := range pc.Assessments {
				<li class="entity-list-row">
					<a href={ templ.URL("/assessments/" + a.ID) } class="entity-list-name">{ conditionTitle(conditions, a.Condition, locale) }</a>
					<div class="row-actions">
						<span class="page-subtitle">{ a.Description }</span>
						<span class="page-subtitle">{ a.RecordedAt.Format("2006-01-02") }</span>
						<a href={ templ.URL("/assessments/" + a.ID) } class="row-action-icon" title="View">
							@web.Icon("chevron_right", 14)
						</a>
					</div>
				</li>
			}
		</ul>
		@assetProjectCardSection("Treatments", "No treatments logged yet.", len(pc.Treatments))
		<ul class="entity-list">
			for _, t := range pc.Treatments {
				<li class="entity-list-row">
					<a href={ templ.URL("/treatments/" + t.ID) } class="entity-list-name">{ t.Title }</a>
					<div class="row-actions">
						<span class="badge">{ treatmentMethodLabel(treatmentMethodLabels, t.Method) }</span>
						<span class="page-subtitle">{ t.PerformedAt.Format("2006-01-02") }</span>
						<a href={ templ.URL("/treatments/" + t.ID) } class="row-action-icon" title="View">
							@web.Icon("chevron_right", 14)
						</a>
						<a href={ templ.URL("/treatments/" + t.ID + "/edit") } class="row-action-icon" title="Edit">
							@web.Icon("edit", 14)
						</a>
						<form method="post" action={ templ.URL("/treatments/" + t.ID + "/unlink") } data-confirm={ "Unlink \"" + t.Title + "\"? It stays in the database but won't show here anymore." }>
							<button type="submit" class="row-action-icon" title="Unlink">
								@web.Icon("close", 14)
							</button>
						</form>
					</div>
				</li>
			}
		</ul>
		@assetProjectCardSection("Reports", "No reports yet for this object.", len(pc.Reports))
		<ul class="entity-list">
			for _, rep := range pc.Reports {
				<li class="entity-list-row">
					<a href={ templ.URL("/reports/" + rep.ID) } class="entity-list-name">{ rep.Title }</a>
					<div class="row-actions">
						<span class="badge">{ rep.Status }</span>
						<a href={ templ.URL("/reports/" + rep.ID) } class="row-action-icon" title="View">
							@web.Icon("chevron_right", 14)
						</a>
						<form method="post" action={ templ.URL("/reports/" + rep.ID + "/unlink") } data-confirm={ "Unlink \"" + rep.Title + "\"? It stays in the database but won't show here anymore." }>
							<button type="submit" class="row-action-icon" title="Unlink">
								@web.Icon("close", 14)
							</button>
						</form>
					</div>
				</li>
			}
		</ul>
	</div>
}

templ assetProjectCardSection(label, emptyLabel string, count int) {
	<div class="dashboard-project-card-heading">
		<span class="dashboard-project-card-label">{ label }</span>
		if count == 0 {
			<span class="page-subtitle">{ emptyLabel }</span>
		}
	</div>
}

func mediaViewHref(ref media.ReferenceWithMedia) templ.SafeURL {
	if ref.Media.Kind == media.KindVideo {
		return templ.URL("/api/media/" + ref.MediaID + "?variant=original")
	}
	return templ.URL("/media/view/" + ref.MediaID)
}

func assetTypeTitle(assetType *settings.Classifier, locale i18n.Locale) string {
	if assetType == nil {
		return ""
	}
	return settings.ClassifierLabel(*assetType, locale)
}

templ EditPage(c web.Chrome, asset Asset) {
	@web.AppLayout("Edit "+asset.DisplayName(), c, editBody(asset))
}

templ editBody(asset Asset) {
	@web.PageHeader("Edit "+asset.DisplayName(), "", templ.NopComponent)
	@web.Card() {
		<form method="post" action={ templ.URL("/assets/" + asset.ID + "/update") } class="form-grid">
			@web.Field("Title", "") {
				<input class="input" name="title" value={ asset.Title.String }/>
			}
			@web.Field("Artist", "") {
				<input class="input" name="artist" value={ asset.Artist.String }/>
			}
			@web.Field("Creation period", "") {
				<input class="input" name="creationPeriod" value={ asset.CreationPeriod.String }/>
			}
			@web.Field("Dimensions", "") {
				<input class="input" name="dimensions" value={ asset.Dimensions.String }/>
			}
			@web.Field("Medium", "") {
				<input class="input" name="medium" value={ asset.Medium.String }/>
			}
			@web.Field("Weight", "") {
				<input class="input" name="weight" value={ asset.Weight.String }/>
			}
			@web.Field("Signature / marks", "") {
				<input class="input" name="signatureMarks" value={ asset.SignatureMarks.String }/>
			}
			@web.Field("Location in studio", "") {
				<input class="input" name="locationInStudio" value={ asset.LocationInStudio.String }/>
			}
			@web.Field("Description", "") {
				<textarea class="input" name="description" rows="2">{ asset.Description.String }</textarea>
			}
			@web.Field("Provenance", "") {
				<textarea class="input" name="provenance" rows="2">{ asset.Provenance.String }</textarea>
			}
			@web.Field("Acquisition date", "") {
				<input class="input" type="date" name="acquisitionDate" value={ acquisitionDateInputValue(asset) }/>
			}
			@web.Field("Estimated value", "") {
				<input class="input" type="number" step="0.01" name="estimatedValue" value={ estimatedValueInputValue(asset) }/>
			}
			@web.Field("Insured", "") {
				<select class="input" name="isInsured">
					<option value="" selected?={ !asset.IsInsured.Valid }>Unknown</option>
					<option value="true" selected?={ asset.IsInsured.Valid && asset.IsInsured.Bool }>Yes</option>
					<option value="false" selected?={ asset.IsInsured.Valid && !asset.IsInsured.Bool }>No</option>
				</select>
			}
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">
					@web.Icon("check_circle", 14)
					Save
				</button>
				<a class="btn btn-ghost" href={ templ.URL("/assets/" + asset.ID) }>
					@web.Icon("close", 14)
					Cancel
				</a>
			</div>
		</form>
	}
}

templ assetActions(asset Asset) {
	<a class="btn btn-secondary" href={ templ.URL("/assets/" + asset.ID + "/edit") }>
		@web.Icon("edit", 14)
		Edit
	</a>
	<a class="btn btn-secondary" href={ templ.URL("/projects/new?assetId=" + asset.ID) }>
		@web.Icon("history", 14)
		Start project
	</a>
	@web.ExportLinks("asset", asset.ID)
}

templ detailField(label, value string) {
	<div>
		<dt class="detail-dt">{ label }</dt>
		<dd class="detail-dd">
			if value == "" {
				—
			} else {
				{ value }
			}
		</dd>
	</div>
}

func insuredLabel(b sql.NullBool) string {
	if !b.Valid {
		return ""
	}
	if b.Bool {
		return "Yes"
	}
	return "No"
}

func estimatedValueLabel(f sql.NullFloat64) string {
	if !f.Valid {
		return ""
	}
	return strconv.FormatFloat(f.Float64, 'f', 2, 64)
}

func estimatedValueInputValue(asset Asset) string {
	if !asset.EstimatedValue.Valid {
		return ""
	}
	return strconv.FormatFloat(asset.EstimatedValue.Float64, 'f', 2, 64)
}

func acquisitionDateLabel(t sql.NullTime) string {
	if !t.Valid {
		return ""
	}
	return t.Time.Format("2006-01-02")
}

func acquisitionDateInputValue(asset Asset) string {
	if !asset.AcquisitionDate.Valid {
		return ""
	}
	return asset.AcquisitionDate.Time.Format("2006-01-02")
}

func conditionTitle(conditions []settings.Classifier, code string, locale i18n.Locale) string {
	for _, c := range conditions {
		if c.Code == code {
			return settings.ClassifierLabel(c, locale)
		}
	}
	return code
}

func treatmentMethodLabel(labels map[string]string, code string) string {
	if label, ok := labels[code]; ok {
		return label
	}
	return code
}
