package media

import (
	"strconv"

	"studio/internal/web"
)

templ AlbumPage(c web.Chrome, items []AlbumItem) {
	@web.AppLayout("Media", c, albumBody(items))
}

templ albumBody(items []AlbumItem) {
	@web.PageHeader("Media", "Every photo, video, and document uploaded anywhere in the app.", templ.NopComponent)
	<div id="album-root" class="album-root">
		<div class="album-controls">
			<input type="text" id="album-search" class="input album-search" placeholder="Search…"/>
			<div class="album-kind-filters" id="album-kind-filters">
				<button type="button" class="btn btn-secondary album-kind-btn is-active" data-kind="all">All</button>
				<button type="button" class="btn btn-secondary album-kind-btn" data-kind="image">Images</button>
				<button type="button" class="btn btn-secondary album-kind-btn" data-kind="video">Video</button>
				<button type="button" class="btn btn-secondary album-kind-btn" data-kind="document">Documents</button>
			</div>
			<label class="checkbox-field album-group-toggle">
				<input type="checkbox" id="album-group-toggle"/>
				Group by project
			</label>
			<span class="badge" id="album-count">{ strconv.Itoa(len(items)) } items</span>
		</div>
		if len(items) == 0 {
			<p class="empty-state">No media uploaded yet.</p>
		}
		<div class="album-grid" id="album-grid">
			for _, item := range items {
				@albumCard(item)
			}
		</div>
	</div>
	<script src="/static/js/album.js" defer></script>
}

templ albumCard(item AlbumItem) {
	<a
		href={ templ.URL("/media/view/" + item.ID) }
		class="album-card"
		data-kind={ string(item.Kind) }
		data-project-id={ item.ProjectID.String }
		data-project-title={ projectGroupTitle(item) }
		data-search={ albumSearchHaystack(item) }
	>
		<div class="album-thumb">
			if item.Kind == KindVideo {
				<video src={ "/api/media/" + item.ID + "?variant=original" } muted></video>
			} else if item.Kind == KindImage {
				<img src={ "/api/media/" + item.ID } alt={ item.Role.String }/>
			} else {
				<div class="album-thumb-doc">{ item.MimeType }</div>
			}
		</div>
		<div class="album-card-body">
			<div class="album-card-title">
				if item.Role.Valid && item.Role.String != "" {
					{ item.Role.String }
				} else {
					{ string(item.Kind) }
				}
				if item.DerivedLabel.Valid {
					<span class="page-subtitle">({ item.DerivedLabel.String })</span>
				}
			</div>
			<div class="album-card-sub">
				if item.AssetTitle.Valid {
					{ item.AssetTitle.String }
				} else if item.ClientName.Valid {
					{ item.ClientName.String }
				} else {
					unattached
				}
			</div>
		</div>
	</a>
}

func projectGroupTitle(item AlbumItem) string {
	if item.ProjectTitle.Valid {
		return item.ProjectTitle.String
	}
	return "No project"
}

func albumSearchHaystack(item AlbumItem) string {
	parts := []string{item.Role.String, item.AssetTitle.String, item.ProjectTitle.String, item.ClientName.String, item.MimeType, item.UploadedByName}
	out := ""
	for _, p := range parts {
		if p != "" {
			out += p + " "
		}
	}
	return out
}

templ MediaViewPage(c web.Chrome, m Media, uploadedByName string, reference *Reference, regions []AnnotationRegion, annotationTypes []AnnotationTypeOption, source *Media, derivedVersions []Media) {
	@web.AppLayout(mediaViewTitle(m, reference), c, mediaViewBody(m, uploadedByName, reference, regions, annotationTypes, source, derivedVersions))
}

templ mediaViewBody(m Media, uploadedByName string, reference *Reference, regions []AnnotationRegion, annotationTypes []AnnotationTypeOption, source *Media, derivedVersions []Media) {
	@web.PageHeader(mediaViewTitle(m, reference), mediaViewSubtitle(m, uploadedByName), mediaViewActions(m, source))
	if m.IsAnnotatedVersion() && source != nil {
		<p class="page-subtitle" style="margin-top:-0.75rem;margin-bottom:1rem;">
			Annotated from <a href={ templ.URL("/media/view/" + source.ID) }>{ mediaViewTitle(*source, nil) }</a>
		</p>
	}
	@web.Card() {
		<div class="row-actions" style="margin-bottom: 0.75rem;">
			<span class="badge">{ string(m.Kind) }</span>
			<span class="badge">{ m.MimeType }</span>
			if m.Width.Valid && m.Height.Valid {
				<span class="badge">{ strconv.FormatInt(m.Width.Int64, 10) }×{ strconv.FormatInt(m.Height.Int64, 10) }px</span>
			}
			if m.DurationSeconds.Valid {
				<span class="badge">{ strconv.FormatInt(m.DurationSeconds.Int64, 10) }s</span>
			}
		</div>
		if m.Kind == KindImage {
			<button type="button" id="lightbox-trigger" class="lightbox-trigger" data-media-id={ m.ID } aria-label="Open image viewer">
				if m.IsAnnotatedVersion() && !m.IsBaked() {
					<p class="empty-state" style="margin:0;padding:3rem 1rem;">Not saved yet — open the editor, mark a region, then close it to save this version.</p>
				} else {
					<img src={ "/api/media/" + m.ID } alt=""/>
				}
			</button>
			<p class="page-subtitle" style="text-align: center; margin-top: 0.5rem;">
				if m.IsAnnotatedVersion() {
					Click to open · zoom, annotate
				} else {
					Click to open · zoom
				}
			</p>
		}
		if m.Kind == KindVideo {
			<video controls class="media-view-video" src={ "/api/media/" + m.ID + "?variant=original" }></video>
		}
		if m.Kind == KindDocument {
			<p class="page-subtitle">No preview available for this file type.</p>
		}
	}
	if !m.IsAnnotatedVersion() && m.Kind == KindImage {
		@annotatedVersionsCard(m, derivedVersions)
	}
	if m.Kind == KindImage {
		@lightboxModal(m, regions, annotationTypes, source)
		<script src="/static/openseadragon/openseadragon.min.js" defer></script>
		<script src="/static/js/lightbox.js" defer></script>
	}
}

// annotatedVersionsCard lists a true original's annotated versions (each its own persisted Media
// - see CreateAnnotatedVersion/BakeAnnotatedVersion) and the entry point to start another one.
// There's no separate "continue" action here: continuing an existing version is just opening its
// own page, since its regions already belong to it.
templ annotatedVersionsCard(m Media, derivedVersions []Media) {
	@web.Card() {
		<div class="card-header-row">
			<h2 class="dashboard-heading">Annotated versions</h2>
			<form method="post" action={ templ.URL("/media/" + m.ID + "/annotated-versions") }>
				<button type="submit" class="btn btn-secondary">
					<img src="/static/icons/add.svg" width="14" height="14" alt="" class="icon"/>
					New annotated version
				</button>
			</form>
		</div>
		if len(derivedVersions) == 0 {
			<p class="empty-state">No annotated versions yet.</p>
		} else {
			<ul class="entity-list">
				for _, v := range derivedVersions {
					<li class="entity-list-row">
						<a href={ templ.URL("/media/view/" + v.ID) } class="entity-list-name">{ v.DerivedLabel.String }</a>
						<div class="row-actions">
							if !v.IsBaked() {
								<span class="badge badge-amber">Not saved yet</span>
							}
						</div>
					</li>
				}
			</ul>
		}
	}
}

// hatchTileSize is the pattern tile's size in the shared 0-100 (percent-of-image) coordinate
// space region shapes live in - smaller means more stripes packed into the same area. 2 (was 6)
// roughly triples the stripe count so damage/loss patterns stay readable at both a glance and
// zoomed in, rather than thinning out to near-solid on a large photo.
const hatchTileSize = "2"

templ hatchPatternDef(t AnnotationTypeOption) {
	<pattern
		id={ "pattern-" + t.ID }
		width={ hatchTileSize }
		height={ hatchTileSize }
		patternUnits="userSpaceOnUse"
		patternTransform={ "rotate(" + strconv.Itoa(HatchAngle(t.Hatch)) + ")" }
	>
		<line x1="0" y1="1" x2="2" y2="1" stroke={ t.Color } stroke-width="0.9"></line>
	</pattern>
}

// regionShape renders one stored region as either an SVG <rect> (shape=="rect", the common case)
// or a <polygon> (shape=="freehand", a brush-drawn outline — see AnnotationRegion.PathData). Both
// share the same pattern fill, keyed by the region's annotation type.
templ regionShape(r AnnotationRegion, t AnnotationTypeOption) {
	if t.ID != "" {
		if r.Shape == "freehand" && r.PathData.Valid {
			<polygon
				points={ PolygonPoints(r.PathData.String) }
				fill={ "url(#pattern-" + t.ID + ")" }
				stroke={ t.Color }
				stroke-width="0.3"
				fill-opacity="0.55"
			></polygon>
		} else {
			<rect
				x={ formatPct(r.XPct) }
				y={ formatPct(r.YPct) }
				width={ formatPct(r.WidthPct) }
				height={ formatPct(r.HeightPct) }
				fill={ "url(#pattern-" + t.ID + ")" }
				stroke={ t.Color }
				stroke-width="0.3"
				fill-opacity="0.55"
			></rect>
		}
	}
}

templ patternLayerLegend(regions []AnnotationRegion, annotationTypes []AnnotationTypeOption) {
	<div class="pattern-layer-legend">
		if len(regions) == 0 {
			<p class="page-subtitle">No regions marked yet.</p>
		} else {
			<div class="pattern-layer-legend-swatches">
				for _, t := range UsedTypeOptions(regions, annotationTypes) {
					<div class="pattern-layer-legend-item">
						<span class="pattern-layer-swatch" style={ "background-color:" + t.Color }></span>
						{ t.Label }
					</div>
				}
			</div>
			<ul class="pattern-layer-region-list">
				for _, r := range regions {
					<li>
						<span>{ OptionByID(annotationTypes, r.AnnotationTypeID).Label }</span>
						<form method="post" action={ templ.URL("/media/" + r.MediaID + "/annotations/" + r.ID + "/delete") } data-confirm="Remove this region?">
							<button type="submit" class="tag-pill-remove" aria-label="Remove region">
								<img src="/static/icons/close.svg" width="10" height="10" alt="" class="icon"/>
							</button>
						</form>
					</li>
				}
			</ul>
		}
	</div>
}

func formatPct(n float64) string {
	return strconv.FormatFloat(n, 'f', 3, 64)
}

// lightboxModal is the media module's one image viewer/editor: real OpenSeadragon deep zoom
// (static/openseadragon/, vendored — the one deliberate exception to this app's usual
// "no vendored libraries" rule, see static/js/lightbox.js's header comment) against the real IIIF
// Image API (internal/iiif) as the viewing surface - a clean canvas with no OpenSeadragon toolbar/
// navigator, just the image and the pattern layer on top of it - combined with the pattern layer
// (a percentage-coordinate SVG overlay of stored regions - rect or freehand-brush outlines, see
// AnnotationRegion - added as an OpenSeadragon overlay so it tracks pan/zoom automatically), a
// rectangle/brush draw tool (armed by default) with a type dropdown ("the reason" for a marked
// area), a legend directly under the image (whether or not there's anything marked yet), and a
// whole-image note (Media.Description) as a single inline row with its own save button - persisted
// via POST /media/{id}/description, unlike the region shapes (already auto-saved per-draw). No
// raster editing, no undo stack - regions are rows (internal/media/annotations.go), never baked
// into a new image (that only happens server-side, on demand, for downloads/exports - see
// internal/media/rasterize.go, and mediaViewActions above for the only download buttons - none
// live in this modal). This used to be two disconnected modals (a flat-image editor with no real
// zoom, and a separate read-only deep-zoom viewer with no editing) - one viewing surface now
// carries every feature.
templ lightboxModal(m Media, regions []AnnotationRegion, annotationTypes []AnnotationTypeOption, source *Media) {
	<div id="lightbox-overlay" class="lightbox-overlay" hidden>
		<div class="lightbox-modal">
			<button type="button" id="lightbox-close" class="lightbox-close" aria-label="Close">
				<img src="/static/icons/close.svg" width="18" height="18" alt="" class="icon"/>
			</button>
			<div class="lightbox-image-wrap">
				<div
					class="pattern-layer-stage"
					id="pattern-layer-wrap"
					data-media-id={ m.ID }
					data-bake-if-annotated={ strconv.FormatBool(m.IsAnnotatedVersion()) }
					data-info-url={ "/api/iiif/" + tileSourceID(m, source) + "/info.json" }
				>
					<div id="osd-viewer" class="osd-viewer"></div>
					<svg id="pattern-layer-svg" class="osd-annotation-overlay" viewBox="0 0 100 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
						<defs>
							for _, t := range UsedTypeOptions(regions, annotationTypes) {
								@hatchPatternDef(t)
							}
						</defs>
						for _, r := range regions {
							@regionShape(r, OptionByID(annotationTypes, r.AnnotationTypeID))
						}
					</svg>
				</div>
			</div>
			if m.IsAnnotatedVersion() {
				@patternLayerLegend(regions, annotationTypes)
				<div class="lightbox-controls">
					if len(annotationTypes) == 0 {
						<p class="page-subtitle">No annotation types configured — add some under Settings → Classifiers → Annotation Types before marking a loss/damage area.</p>
					} else {
						<div class="lightbox-control-row pattern-layer-toolbar">
							<label class="checkbox-field">
								<input type="checkbox" id="pattern-layer-add-toggle" checked/>
								+ Add region
							</label>
							<div class="pattern-layer-tool-group" role="group" aria-label="Draw tool">
								<button type="button" id="pattern-layer-tool-rect" class="pattern-layer-tool-btn is-active" data-tool="rect" title="Rectangle" aria-label="Rectangle">
									<img src="/static/icons/rectangle.svg" width="16" height="16" alt="" class="icon"/>
								</button>
								<button type="button" id="pattern-layer-tool-freehand" class="pattern-layer-tool-btn" data-tool="freehand" title="Freehand brush" aria-label="Freehand brush">
									<img src="/static/icons/brush.svg" width="16" height="16" alt="" class="icon"/>
								</button>
							</div>
							<label class="pattern-layer-select-field">
								Type
								<select id="pattern-layer-type" class="input">
									for _, t := range annotationTypes {
										<option value={ t.ID }>{ t.Label }</option>
									}
								</select>
							</label>
						</div>
					}
					<form id="lightbox-description-form" class="lightbox-note-row" data-media-id={ m.ID }>
						<label for="lightbox-description">Note</label>
						<input type="text" id="lightbox-description" name="description" class="input" placeholder="Add a note…" value={ m.Description.String }/>
						<button type="submit" class="btn btn-secondary" title="Save note" aria-label="Save note">
							<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon"/>
						</button>
					</form>
				</div>
			}
		</div>
	</div>
}

// tileSourceID is whose IIIF endpoint the deep-zoom stage tiles against: an annotated version
// always shows its true original's (grayscale, see static/js/lightbox.js) pixels live while
// editing - the version's own file only exists once baked, and even then the editor always edits
// against the original, never a previously-baked-with-legend copy of itself.
func tileSourceID(m Media, source *Media) string {
	if source != nil {
		return source.ID
	}
	return m.ID
}

// mediaViewActions is the only place download links appear (the lightbox editor itself has none).
// A true original just downloads itself. An annotated version downloads its own baked file by
// default (the composited PNG - see BakeAnnotatedVersion), with "Download original" alongside it
// for the un-annotated source. Multiple annotated versions can exist per original now, so there's
// no single "the annotated variant" of an original to default to any more - that's what each
// version's own page is for.
templ mediaViewActions(m Media, source *Media) {
	if m.IsAnnotatedVersion() && m.IsBaked() {
		<a class="btn btn-secondary" href={ templ.URL("/api/media/" + m.ID + "?variant=original") }>
			<img src="/static/icons/download.svg" width="14" height="14" alt="" class="icon"/>
			Download
		</a>
		if source != nil {
			<a class="btn btn-ghost" href={ templ.URL("/api/media/" + source.ID + "?variant=original") }>
				<img src="/static/icons/download.svg" width="14" height="14" alt="" class="icon"/>
				Download original
			</a>
		}
	} else if !m.IsAnnotatedVersion() {
		<a class="btn btn-secondary" href={ templ.URL("/api/media/" + m.ID + "?variant=original") }>
			<img src="/static/icons/download.svg" width="14" height="14" alt="" class="icon"/>
			Download
		</a>
	}
	<a class="btn btn-ghost" href="/media">
		<img src="/static/icons/chevron-right.svg" width="14" height="14" alt="" class="icon" style="transform: rotate(180deg);"/>
		Back
	</a>
}

func mediaViewTitle(m Media, reference *Reference) string {
	base := string(m.Kind)
	if reference != nil && reference.Role.Valid && reference.Role.String != "" {
		base = reference.Role.String
	}
	if m.DerivedLabel.Valid {
		return base + " (" + m.DerivedLabel.String + ")"
	}
	return base
}

func mediaViewSubtitle(m Media, uploadedByName string) string {
	return "Uploaded by " + uploadedByName + " · " + m.CreatedAt.Format("2006-01-02 15:04") + " · " + strconv.FormatInt(m.SizeBytes/1024, 10) + " KB"
}

// MediaGrid renders every media reference for one entity (Asset/Project/Assessment/Activity/
// Report/Treatment) - a small grid of thumbnails linking to the lightbox viewer (images) or the
// raw file (video). Reused from every module's detail page (Assets, Projects, Reports,
// Treatments, Assessments).
templ MediaGrid(refs []ReferenceWithMedia) {
	if len(refs) > 0 {
		<div class="media-grid">
			for _, ref := range refs {
				<a href={ mediaGridHref(ref) } target="_blank" rel="noreferrer" class="media-grid-item">
					if ref.Media.Kind == KindVideo {
						<video src={ "/api/media/" + ref.MediaID + "?variant=original" } muted></video>
					} else {
						<img src={ "/api/media/" + ref.MediaID } alt={ ref.Role.String }/>
					}
				</a>
			}
		</div>
	}
}

func mediaGridHref(ref ReferenceWithMedia) templ.SafeURL {
	if ref.Media.Kind == KindVideo {
		return templ.URL("/api/media/" + ref.MediaID + "?variant=original")
	}
	return templ.URL("/media/view/" + ref.MediaID)
}
