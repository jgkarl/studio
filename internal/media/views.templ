package media

import (
	"strconv"

	"studio/internal/web"
)

templ AlbumPage(c web.Chrome, items []AlbumItem) {
	@web.AppLayout("Media", c, albumBody(items))
}

templ albumBody(items []AlbumItem) {
	@web.PageHeader("Media", "Every photo, video, and document uploaded anywhere in the app.", templ.NopComponent)
	<div id="album-root" class="album-root">
		<div class="album-controls">
			<input type="text" id="album-search" class="input album-search" placeholder="Search…"/>
			<div class="album-kind-filters" id="album-kind-filters">
				<button type="button" class="btn btn-secondary album-kind-btn is-active" data-kind="all">All</button>
				<button type="button" class="btn btn-secondary album-kind-btn" data-kind="image">Images</button>
				<button type="button" class="btn btn-secondary album-kind-btn" data-kind="video">Video</button>
				<button type="button" class="btn btn-secondary album-kind-btn" data-kind="document">Documents</button>
			</div>
			<label class="checkbox-field album-group-toggle">
				<input type="checkbox" id="album-group-toggle"/>
				Group by project
			</label>
			<span class="badge" id="album-count">{ strconv.Itoa(len(items)) } items</span>
		</div>
		if len(items) == 0 {
			<p class="empty-state">No media uploaded yet.</p>
		}
		<div class="album-grid" id="album-grid">
			for _, item := range items {
				@albumCard(item)
			}
		</div>
	</div>
	<script src="/static/js/album.js" defer></script>
}

templ albumCard(item AlbumItem) {
	<a
		href={ templ.URL("/media/view/" + item.ID) }
		class="album-card"
		data-kind={ string(item.Kind) }
		data-project-id={ item.ProjectID.String }
		data-project-title={ projectGroupTitle(item) }
		data-search={ albumSearchHaystack(item) }
	>
		<div class="album-thumb">
			if item.Kind == KindVideo {
				<video src={ "/api/media/" + item.ID + "?variant=original" } muted></video>
			} else if item.Kind == KindImage {
				<img src={ "/api/media/" + item.ID } alt={ item.Role.String }/>
			} else {
				<div class="album-thumb-doc">{ item.MimeType }</div>
			}
		</div>
		<div class="album-card-body">
			<div class="album-card-title">
				if item.Role.Valid && item.Role.String != "" {
					{ item.Role.String }
				} else {
					{ string(item.Kind) }
				}
			</div>
			<div class="album-card-sub">
				if item.AssetTitle.Valid {
					{ item.AssetTitle.String }
				} else if item.ClientName.Valid {
					{ item.ClientName.String }
				} else {
					unattached
				}
			</div>
		</div>
	</a>
}

func projectGroupTitle(item AlbumItem) string {
	if item.ProjectTitle.Valid {
		return item.ProjectTitle.String
	}
	return "No project"
}

func albumSearchHaystack(item AlbumItem) string {
	parts := []string{item.Role.String, item.AssetTitle.String, item.ProjectTitle.String, item.ClientName.String, item.MimeType, item.UploadedByName}
	out := ""
	for _, p := range parts {
		if p != "" {
			out += p + " "
		}
	}
	return out
}

templ MediaViewPage(c web.Chrome, m Media, uploadedByName string, reference *Reference, regions []AnnotationRegion, annotationTypes []AnnotationTypeOption) {
	@web.AppLayout(mediaViewTitle(m, reference), c, mediaViewBody(m, uploadedByName, reference, regions, annotationTypes))
}

templ mediaViewBody(m Media, uploadedByName string, reference *Reference, regions []AnnotationRegion, annotationTypes []AnnotationTypeOption) {
	@web.PageHeader(mediaViewTitle(m, reference), mediaViewSubtitle(m, uploadedByName), mediaViewActions(m))
	@web.Card() {
		<div class="row-actions" style="margin-bottom: 0.75rem;">
			<span class="badge">{ string(m.Kind) }</span>
			<span class="badge">{ m.MimeType }</span>
			if m.Width.Valid && m.Height.Valid {
				<span class="badge">{ strconv.FormatInt(m.Width.Int64, 10) }×{ strconv.FormatInt(m.Height.Int64, 10) }px</span>
			}
			if m.DurationSeconds.Valid {
				<span class="badge">{ strconv.FormatInt(m.DurationSeconds.Int64, 10) }s</span>
			}
		</div>
		if m.Kind == KindImage {
			<button type="button" id="lightbox-trigger" class="lightbox-trigger" data-media-id={ m.ID } aria-label="Open image viewer">
				<img src={ "/api/media/" + m.ID } alt=""/>
			</button>
			<div class="row-actions" style="justify-content: center; margin-top: 0.5rem;">
				<p class="page-subtitle" style="margin: 0;">Click to open · rotate, adjust, annotate</p>
				<button type="button" id="iiif-viewer-trigger" class="btn btn-secondary">Deep zoom</button>
			</div>
		}
		if m.Kind == KindVideo {
			<video controls class="media-view-video" src={ "/api/media/" + m.ID + "?variant=original" }></video>
		}
		if m.Kind == KindDocument {
			<p class="page-subtitle">No preview available for this file type.</p>
		}
	}
	if m.Kind == KindImage {
		@lightboxModal(m.ID)
		<script src="/static/js/lightbox.js" defer></script>
		@iiifViewerModal(m.ID)
		<script src="/static/js/iiif-viewer.js" defer></script>
		@patternLayerCard(m, regions, annotationTypes)
		<script src="/static/js/pattern-layer.js" defer></script>
	}
}

// iiifViewerModal is a read-only deep-zoom viewer backed by the real IIIF Image API
// (internal/iiif) — wheel zooms, drag pans, both recomputing a pct: region server-side crop. Kept
// separate from the pattern-layer card: combining live pan/zoom with drag-to-draw is a much
// harder coordinate-transform problem than either alone. No vendored library (studio-go's own
// README states that as an explicit value) — static/js/iiif-viewer.js is hand-rolled.
templ iiifViewerModal(mediaID string) {
	<div id="iiif-viewer-overlay" class="lightbox-overlay" hidden>
		<div class="lightbox-modal iiif-viewer-modal">
			<button type="button" id="iiif-viewer-close" class="lightbox-close" aria-label="Close">
				<img src="/static/icons/close.svg" width="18" height="18" alt="" class="icon"/>
			</button>
			<div class="iiif-viewer-stage" id="iiif-viewer-stage" data-media-id={ mediaID }>
				<img id="iiif-viewer-image" class="iiif-viewer-image" src={ "/api/iiif/" + mediaID + "/full/max/0/default.jpg" } alt=""/>
			</div>
			<div class="lightbox-control-row iiif-viewer-controls">
				<button type="button" id="iiif-viewer-zoom-out" class="btn btn-secondary" aria-label="Zoom out">−</button>
				<button type="button" id="iiif-viewer-zoom-in" class="btn btn-secondary" aria-label="Zoom in">+</button>
				<button type="button" id="iiif-viewer-reset" class="btn btn-ghost">Reset</button>
				<span class="page-subtitle">Scroll to zoom · drag to pan</span>
			</div>
		</div>
	</div>
}

// patternLayerCard is the "basic pattern layer": the IIIF Image API's quality=gray transform as
// the base image (that's the "bw image of the original"), an absolutely-positioned SVG overlay of
// stored rectangle regions (percentage coordinates, so it stays correct at any rendered size), and
// a legend underneath. Deliberately not the original app's freehand canvas painter — regions are
// data (rows), never baked into a new raster image.
templ patternLayerCard(m Media, regions []AnnotationRegion, annotationTypes []AnnotationTypeOption) {
	@web.Card() {
		<div class="pattern-layer-header">
			<h2 class="dashboard-heading">Pattern layer</h2>
			<div class="pattern-layer-controls">
				<label class="checkbox-field">
					<input type="checkbox" id="pattern-layer-show" checked/>
					Show pattern layer
				</label>
				if len(annotationTypes) > 0 {
					<label class="checkbox-field">
						<input type="checkbox" id="pattern-layer-add-toggle"/>
						+ Add region
					</label>
				}
			</div>
		</div>
		if len(annotationTypes) == 0 {
			<p class="page-subtitle">No annotation types configured — add some under Settings → Classifiers → Annotation Types before drawing regions.</p>
		} else {
			<div class="pattern-layer-palette" id="pattern-layer-palette" hidden>
				for i, t := range annotationTypes {
					<label class="pattern-layer-palette-item">
						<input type="radio" name="pattern-layer-type" value={ t.ID } checked?={ i == 0 }/>
						<span class="pattern-layer-swatch" style={ "background-color:" + t.Color }></span>
						{ t.Label }
					</label>
				}
			</div>
		}
		<div class="pattern-layer-stage" id="pattern-layer-wrap" data-media-id={ m.ID }>
			<img id="pattern-layer-image" class="pattern-layer-image" src={ "/api/iiif/" + m.ID + "/full/max/0/gray.jpg" } alt="Grayscale rendition"/>
			<svg id="pattern-layer-svg" class="pattern-layer-svg" viewBox="0 0 100 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
				<defs>
					for _, t := range UsedTypeOptions(regions, annotationTypes) {
						@hatchPatternDef(t)
					}
				</defs>
				for _, r := range regions {
					@regionRect(r, OptionByID(annotationTypes, r.AnnotationTypeID))
				}
			</svg>
		</div>
		@patternLayerLegend(regions, annotationTypes)
	}
}

templ hatchPatternDef(t AnnotationTypeOption) {
	<pattern
		id={ "pattern-" + t.ID }
		width="6"
		height="6"
		patternUnits="userSpaceOnUse"
		patternTransform={ "rotate(" + strconv.Itoa(HatchAngle(t.Hatch)) + ")" }
	>
		<line x1="0" y1="3" x2="6" y2="3" stroke={ t.Color } stroke-width="1.5"></line>
	</pattern>
}

templ regionRect(r AnnotationRegion, t AnnotationTypeOption) {
	if t.ID != "" {
		<rect
			x={ formatPct(r.XPct) }
			y={ formatPct(r.YPct) }
			width={ formatPct(r.WidthPct) }
			height={ formatPct(r.HeightPct) }
			fill={ "url(#pattern-" + t.ID + ")" }
			stroke={ t.Color }
			stroke-width="0.3"
			fill-opacity="0.55"
		></rect>
	}
}

templ patternLayerLegend(regions []AnnotationRegion, annotationTypes []AnnotationTypeOption) {
	<div class="pattern-layer-legend">
		if len(regions) == 0 {
			<p class="page-subtitle">No regions marked yet.</p>
		} else {
			<div class="pattern-layer-legend-swatches">
				for _, t := range UsedTypeOptions(regions, annotationTypes) {
					<div class="pattern-layer-legend-item">
						<span class="pattern-layer-swatch" style={ "background-color:" + t.Color }></span>
						{ t.Label }
					</div>
				}
			</div>
			<ul class="pattern-layer-region-list">
				for _, r := range regions {
					<li>
						<span>{ OptionByID(annotationTypes, r.AnnotationTypeID).Label }</span>
						<form method="post" action={ templ.URL("/media/" + r.MediaID + "/annotations/" + r.ID + "/delete") } data-confirm="Remove this region?">
							<button type="submit" class="tag-pill-remove" aria-label="Remove region">
								<img src="/static/icons/close.svg" width="10" height="10" alt="" class="icon"/>
							</button>
						</form>
					</li>
				}
			</ul>
		}
	</div>
}

func formatPct(n float64) string {
	return strconv.FormatFloat(n, 'f', 3, 64)
}

// lightboxModal is a simple viewer, not an editor: rotate + brightness/contrast CSS filters and
// one ephemeral annotation textarea (never persisted — matches the design artifact's own
// lightboxNote behavior, local component state that resets on close), plus a download link. No
// canvas, no undo stack, no new Media row on "save" — there's nothing to save.
templ lightboxModal(mediaID string) {
	<div id="lightbox-overlay" class="lightbox-overlay" hidden>
		<div class="lightbox-modal">
			<button type="button" id="lightbox-close" class="lightbox-close" aria-label="Close">
				<img src="/static/icons/close.svg" width="18" height="18" alt="" class="icon"/>
			</button>
			<div class="lightbox-image-wrap">
				<img id="lightbox-image" class="lightbox-image" src={ "/api/media/" + mediaID } alt=""/>
			</div>
			<div class="lightbox-controls">
				<div class="lightbox-control-row">
					<label class="lightbox-slider-field">
						Brightness
						<input type="range" id="lightbox-brightness" min="50" max="150" value="100"/>
					</label>
					<label class="lightbox-slider-field">
						Contrast
						<input type="range" id="lightbox-contrast" min="50" max="150" value="100"/>
					</label>
					<button type="button" id="lightbox-rotate" class="btn btn-secondary">
						Rotate
					</button>
					<button type="button" id="lightbox-reset" class="btn btn-ghost">
						Reset
					</button>
					<a id="lightbox-download" class="btn btn-secondary" href={ templ.URL("/api/media/" + mediaID + "?variant=original") } download>
						<img src="/static/icons/download.svg" width="14" height="14" alt="" class="icon"/>
						Download
					</a>
				</div>
				<textarea id="lightbox-annotation" class="input" rows="2" placeholder="Add a note (not saved)…"></textarea>
			</div>
		</div>
	</div>
}

templ mediaViewActions(m Media) {
	<a class="btn btn-secondary" href={ templ.URL("/api/media/" + m.ID + "?variant=original") }>
		<img src="/static/icons/download.svg" width="14" height="14" alt="" class="icon"/>
		Download
	</a>
	<a class="btn btn-ghost" href="/media">
		<img src="/static/icons/chevron-right.svg" width="14" height="14" alt="" class="icon" style="transform: rotate(180deg);"/>
		Back
	</a>
}

func mediaViewTitle(m Media, reference *Reference) string {
	if reference != nil && reference.Role.Valid && reference.Role.String != "" {
		return reference.Role.String
	}
	return string(m.Kind)
}

func mediaViewSubtitle(m Media, uploadedByName string) string {
	return "Uploaded by " + uploadedByName + " · " + m.CreatedAt.Format("2006-01-02 15:04") + " · " + strconv.FormatInt(m.SizeBytes/1024, 10) + " KB"
}

// MediaGrid renders every media reference for one entity (Asset/AssetState/Activity/Report/
// Treatment) - a small grid of thumbnails linking to the lightbox viewer (images) or the raw
// file (video). Reused from every module's detail page (Assets, Projects, Reports, Treatments).
templ MediaGrid(refs []ReferenceWithMedia) {
	if len(refs) > 0 {
		<div class="media-grid">
			for _, ref := range refs {
				<a href={ mediaGridHref(ref) } target="_blank" rel="noreferrer" class="media-grid-item">
					if ref.Media.Kind == KindVideo {
						<video src={ "/api/media/" + ref.MediaID + "?variant=original" } muted></video>
					} else {
						<img src={ "/api/media/" + ref.MediaID } alt={ ref.Role.String }/>
					}
				</a>
			}
		</div>
	}
}

func mediaGridHref(ref ReferenceWithMedia) templ.SafeURL {
	if ref.Media.Kind == KindVideo {
		return templ.URL("/api/media/" + ref.MediaID + "?variant=original")
	}
	return templ.URL("/media/view/" + ref.MediaID)
}
