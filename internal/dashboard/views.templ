package dashboard

import (
	"strconv"

	"studio/internal/web"
)

templ Page(c web.Chrome,
	clientActive, clientAll, assetActive, assetAll, projectActive, projectAll, reportDraft, reportFinal int,
	cards []projectCard) {
	@web.AppLayout(c.Dict.Dashboard.Title, c, pageBody(c, clientActive, clientAll, assetActive, assetAll,
		projectActive, projectAll, reportDraft, reportFinal, cards))
}

templ pageBody(c web.Chrome,
	clientActive, clientAll, assetActive, assetAll, projectActive, projectAll, reportDraft, reportFinal int,
	cards []projectCard) {
	@web.PageHeader(c.Dict.Dashboard.Title, c.Dict.Dashboard.Subtitle, newIntakeLink())
	<div class="stat-grid">
		@dualStatCard(clientActive, clientAll, c.Dict.Dashboard.ClientsLabel, "/clients")
		@dualStatCard(assetActive, assetAll, c.Dict.Dashboard.AssetsLabel, "/assets")
		@dualStatCard(projectActive, projectAll, c.Dict.Dashboard.ProjectsLabel, "/projects")
		@dualStatCard(reportDraft, reportFinal, c.Dict.Dashboard.ReportsLabel, "/reports")
	</div>
	<h2 class="dashboard-heading">{ c.Dict.Dashboard.ActiveProjectsHeading }</h2>
	if len(cards) == 0 {
		<p class="empty-state">{ c.Dict.Dashboard.NothingInProgress }</p>
	}
	<div class="dashboard-project-cards">
		for _, card := range cards {
			@projectCardView(card, c)
		}
	</div>
}

templ newIntakeLink() {
	<a class="btn btn-primary" href="/assets/new">
		<img src="/static/icons/add.svg" width="16" height="16" alt="" class="icon icon-invert"/>
		New intake
	</a>
}

templ dualStatCard(primary, secondary int, label, href string) {
	<a href={ templ.URL(href) } class="stat-card">
		<div class="stat-value">
			{ strconv.Itoa(primary) }
			<span class="page-subtitle">/ { strconv.Itoa(secondary) }</span>
		</div>
		<div class="stat-label">{ label }</div>
	</a>
}

templ projectCardView(card projectCard, c web.Chrome) {
	<div class="card dashboard-project-card">
		<div class="dashboard-project-card-header">
			<a href={ templ.URL("/projects/" + card.Project.ID) } class="dashboard-project-card-title">
				{ card.Project.Title }
				<span class="dashboard-project-card-asset">({ projectAssetLabel(card) })</span>
			</a>
		</div>
		<div class="dashboard-project-card-body">
			<div>
				@projectCardSection(c.Dict.Dashboard.AssessmentsCardLabel, c.Dict.Dashboard.NoneYet, len(card.Assessments))
				<ul class="dashboard-list">
					for _, a := range card.Assessments {
						<li><a href={ templ.URL("/assessments/" + a.ID) }>{ a.Condition } — { a.RecordedAt.Format("2006-01-02") }</a></li>
					}
				</ul>
			</div>
			<div>
				@projectCardSection(c.Dict.Dashboard.TreatmentsCardLabel, c.Dict.Dashboard.NoneYet, len(card.Treatments))
				<ul class="dashboard-list">
					for _, t := range card.Treatments {
						<li><a href={ templ.URL("/treatments/" + t.ID) }>{ t.Title }</a></li>
					}
				</ul>
			</div>
			<div>
				@projectCardSection(c.Dict.Dashboard.ReportsCardLabel, c.Dict.Dashboard.NoneYet, len(card.Reports))
				<ul class="dashboard-list">
					for _, rep := range card.Reports {
						<li><a href={ templ.URL("/reports/" + rep.ID) }>{ rep.Title }</a></li>
					}
				</ul>
			</div>
		</div>
	</div>
}

func projectAssetLabel(card projectCard) string {
	if card.Project.AssetTitle != "" {
		return card.Project.AssetTitle
	}
	return card.Project.AssetReferenceCode
}

templ projectCardSection(label, emptyLabel string, count int) {
	<div class="dashboard-project-card-heading">
		<span class="dashboard-project-card-label">{ label }</span>
		if count == 0 {
			<span class="page-subtitle">{ emptyLabel }</span>
		}
	</div>
}
