package dashboard

import (
	"strconv"

	"studio/internal/web"
)

templ Page(c web.Chrome, clientCount, assetCount, treatmentCount int, activeProjects []activeProject, draftReportRows []draftReport, draftReports int) {
	@web.AppLayout(c.Dict.Dashboard.Title, c, pageBody(c, clientCount, assetCount, treatmentCount, activeProjects, draftReportRows, draftReports))
}

templ pageBody(c web.Chrome, clientCount, assetCount, treatmentCount int, activeProjects []activeProject, draftReportRows []draftReport, draftReports int) {
	@web.PageHeader(c.Dict.Dashboard.Title, c.Dict.Dashboard.Subtitle, newIntakeLink())
	<div class="stat-grid">
		@statCard(strconv.Itoa(clientCount), c.Dict.Dashboard.Clients, "/clients")
		@statCard(strconv.Itoa(assetCount), c.Dict.Dashboard.Assets, "/assets")
		@statCard(strconv.Itoa(treatmentCount), c.Dict.Dashboard.Treatments, "/treatments")
		@statCard(strconv.Itoa(len(activeProjects)), c.Dict.Dashboard.ActiveProjects, "/projects")
		@statCard(strconv.Itoa(draftReports), c.Dict.Dashboard.DraftReports, "/reports")
	</div>
	<div class="dashboard-columns">
		@web.Card() {
			<h2 class="dashboard-heading">{ c.Dict.Dashboard.ActiveProjectsHeading }</h2>
			if len(activeProjects) == 0 {
				<p class="empty-state">{ c.Dict.Dashboard.NothingInProgress }</p>
			}
			<ul class="dashboard-list">
				for _, p := range activeProjects {
					<li>
						<a href={ templ.URL("/projects/" + p.ID) }>{ p.Title }</a>
						<div class="page-subtitle">
							if p.AssetTitle != "" {
								{ p.AssetTitle }
							} else {
								{ p.AssetReferenceCode }
							}
						</div>
					</li>
				}
			</ul>
		}
		@web.Card() {
			<h2 class="dashboard-heading">{ c.Dict.Dashboard.DraftReportsHeading }</h2>
			if len(draftReportRows) == 0 {
				<p class="empty-state">{ c.Dict.Dashboard.NoDraftReports }</p>
			}
			<ul class="dashboard-list">
				for _, rep := range draftReportRows {
					<li>
						<a href={ templ.URL("/reports/" + rep.ID) }>{ rep.Title }</a>
						<div class="page-subtitle">
							if rep.AssetTitle != "" {
								{ rep.AssetTitle }
							} else {
								{ rep.AssetReferenceCode }
							}
						</div>
					</li>
				}
			</ul>
		}
	</div>
}

templ newIntakeLink() {
	<a class="btn btn-primary" href="/assets/new">
		<img src="/static/icons/add.svg" width="16" height="16" alt="" class="icon icon-invert"/>
		New intake
	</a>
}

templ statCard(value, label, href string) {
	<a href={ templ.URL(href) } class="stat-card">
		<div class="stat-value">{ value }</div>
		<div class="stat-label">{ label }</div>
	</a>
}
