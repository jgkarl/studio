package settings

import (
	"studio/internal/auth"
	"studio/internal/web"
)

var assignableRoles = []auth.Role{auth.RolePending, auth.RoleConservator, auth.RoleAdmin}

templ UsersPage(c web.Chrome, users []auth.User) {
	@web.AppLayout("Users", c, usersBody(users))
}

templ usersBody(users []auth.User) {
	@web.PageHeader("Users", "Approve pending registrations and manage roles.", backToSettingsLink())
	@web.Card() {
		<div class="table-wrap">
			<table class="table">
				<thead>
					<tr>
						<th>Name</th>
						<th>Email</th>
						<th>Provider</th>
						<th>Email</th>
						<th>Role</th>
					</tr>
				</thead>
				<tbody>
					for _, u := range users {
						<tr>
							<td>{ u.Name }</td>
							<td>{ u.Email }</td>
							<td>
								if u.Provider.Valid {
									<span class="badge">{ u.Provider.String }</span>
								} else {
									—
								}
							</td>
							<td>
								if u.Provider.Valid && u.Provider.String == "email" {
									if u.EmailVerifiedAt.Valid {
										<span class="badge badge-green">Confirmed</span>
									} else {
										<span class="badge badge-amber">Awaiting confirmation</span>
									}
								} else {
									<span class="page-subtitle">n/a</span>
								}
							</td>
							<td>
								<form method="post" action={ templ.URL("/settings/users/" + u.ID + "/role") } class="row-actions">
									<select class="input" name="role" style="width: auto;">
										for _, role := range assignableRoles {
											<option value={ string(role) } selected?={ role == u.Role }>{ string(role) }</option>
										}
									</select>
									<button type="submit" class="btn btn-secondary">Save</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}


templ backToSettingsLink() {
	<a class="btn btn-ghost" href="/settings">Back to settings</a>
}
