package settings

import (
	"database/sql"
	"encoding/json"
	"strconv"

	"studio/internal/auth"
	"studio/internal/i18n"
	"studio/internal/web"
)

// tabNav is Settings' tab strip — Classifiers (every signed-in user) and, admin-only, Users.
// Preferences (locale/theme) used to live on this page too; those are now account-menu-only (see
// internal/web/navbar.templ) since they're duplicated there and don't need a second home.
templ tabNav(active string, showUsers bool) {
	<div class="tab-nav">
		<a href="/settings" class={ "tab-nav-link", templ.KV("tab-nav-link-active", active == "classifiers") }>Classifiers</a>
		<a href="/settings/features" class={ "tab-nav-link", templ.KV("tab-nav-link-active", active == "features") }>Features</a>
		if showUsers {
			<a href="/settings/users" class={ "tab-nav-link", templ.KV("tab-nav-link-active", active == "users") }>Users</a>
		}
	</div>
}

templ ClassifiersPage(c web.Chrome, groups []ClassifierGroup, isAdmin bool) {
	@web.AppLayout("Settings", c, classifiersBody(groups, isAdmin, c.Locale))
}

templ classifiersBody(groups []ClassifierGroup, isAdmin bool, locale i18n.Locale) {
	@web.PageHeader("Settings", "Picklists used across the app.", templ.NopComponent)
	@tabNav("classifiers", isAdmin)
	for _, group := range groups {
		@classifierGroupCard(group, locale)
	}
}

// FeaturesPage holds the two admin-configurable behaviors that aren't a Classifier picklist: the
// Dashboard's per-module list caps, and which Client/Asset/Project fields a generated Report's
// info panel includes (see internal/settings/appsetting.go, features.go, reportable.go).
templ FeaturesPage(c web.Chrome, limits []FeatureLimitValue, reportableGroups []ReportableGroup, isAdmin bool) {
	@web.AppLayout("Settings", c, featuresBody(limits, reportableGroups, isAdmin))
}

templ featuresBody(limits []FeatureLimitValue, reportableGroups []ReportableGroup, isAdmin bool) {
	@web.PageHeader("Settings", "Dashboard limits and report contents.", templ.NopComponent)
	@tabNav("features", isAdmin)
	@web.Card() {
		<h2 class="dashboard-heading">Dashboard limits</h2>
		<p class="page-subtitle">How many rows the Dashboard shows per list.</p>
		<form method="post" action="/settings/features" class="form-grid">
			for _, l := range limits {
				@web.Field(l.Label, "") {
					<input class="input" type="number" min="1" max="50" name={ l.Key } value={ strconv.Itoa(l.Value) }/>
				}
			}
			<button type="submit" class="btn btn-primary">
				@web.Icon("check_circle", 14)
				Save limits
			</button>
		</form>
	}
	@web.Card() {
		<h2 class="dashboard-heading">Reportable fields</h2>
		<p class="page-subtitle">Which fields show in a generated Report's Client/Asset/Project info panel.</p>
		<form method="post" action="/settings/reportable" class="form-grid">
			for _, group := range reportableGroups {
				<div class="form-section">
					<p class="form-section-title">{ group.Label }</p>
					<div class="checkbox-grid">
						for _, f := range group.Fields {
							<label class="checkbox-field">
								<input type="checkbox" name={ "reportable." + group.Model + "." + f.Field } checked?={ f.Enabled }/>
								{ f.Label }
							</label>
						}
					</div>
				</div>
			}
			<button type="submit" class="btn btn-primary">
				@web.Icon("check_circle", 14)
				Save reportable fields
			</button>
		</form>
	}
}

templ UsersPage(c web.Chrome, users []auth.User) {
	@web.AppLayout("Settings", c, usersBody(users))
}

templ usersBody(users []auth.User) {
	@web.PageHeader("Settings", "User accounts and roles.", templ.NopComponent)
	@tabNav("users", true)
	@web.Card() {
		if len(users) == 0 {
			<p class="empty-state">No users yet.</p>
		}
		<div class="table-wrap">
			<table class="table">
				<thead>
					<tr>
						<th>Name</th>
						<th>Email</th>
						<th>Status</th>
						<th>Role</th>
					</tr>
				</thead>
				<tbody>
					for _, u := range users {
						<tr>
							<td>{ u.Name }</td>
							<td>{ u.Email }</td>
							<td>
								if u.Provider.Valid && u.Provider.String == "email" {
									if u.EmailVerifiedAt.Valid {
										<span class="badge badge-green">Confirmed</span>
									} else {
										<span class="badge badge-amber">Awaiting confirmation</span>
									}
								} else {
									<span class="page-subtitle">n/a</span>
								}
							</td>
							<td>
								<form method="post" action={ templ.URL("/settings/users/" + u.ID + "/role") } class="row-actions">
									<select class="input" name="role" style="width: auto;">
										for _, role := range assignableRoles {
											<option value={ string(role) } selected?={ role == u.Role }>{ string(role) }</option>
										}
									</select>
									<button type="submit" class="btn btn-secondary">
										@web.Icon("check_circle", 14)
										Save
									</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ classifierGroupCard(group ClassifierGroup, locale i18n.Locale) {
	@web.Card() {
		<h2 class="dashboard-heading">{ group.Label }</h2>
		if len(group.Rows) == 0 {
			<p class="empty-state">No options yet.</p>
		}
		<div class="tag-pills">
			for _, row := range group.Rows {
				@classifierPill(group.Type, row, locale)
			}
		</div>
		<form method="post" action={ templ.URL("/settings/classifiers/" + string(group.Type)) } class="inline-edit-form inline-edit-form-row">
			<input class="input" name="title" required placeholder="Title (English)"/>
			<input class="input" name="titleEt" placeholder="Title (Estonian)"/>
			<input class="input classifier-sequence-input" type="number" name="sequence" placeholder="Order"/>
			if group.Type == ClassifierAnnotationType {
				@annotationSwatchFields(annotationSwatch{Hatch: "hatch-diagonal", Color: "#dc2626"})
			}
			<button type="submit" class="btn btn-secondary" aria-label="Add" title="Add">
				@web.Icon("add", 14)
				<span class="btn-label">Add</span>
			</button>
		</form>
	}
}

// annotationSwatch is the {"hatch","color"} shape a Classifier.Data JSON holds for the
// annotation_type group - internal/media/annotations.go's AnnotationTypeData decodes the exact
// same shape server-side when rendering the pattern layer; duplicated here (rather than imported)
// since internal/media already imports internal/settings, and settings importing media back would
// be circular.
type annotationSwatch struct {
	Hatch string `json:"hatch"`
	Color string `json:"color"`
}

var hatchOptions = []struct{ Value, Label string }{
	{"hatch-horizontal", "Horizontal"},
	{"hatch-vertical", "Vertical"},
	{"hatch-diagonal", "Diagonal"},
	{"hatch-antidiagonal", "Antidiagonal"},
}

func decodeAnnotationSwatch(data sql.NullString) annotationSwatch {
	out := annotationSwatch{Hatch: "hatch-diagonal", Color: "#dc2626"}
	if data.Valid && data.String != "" {
		_ = json.Unmarshal([]byte(data.String), &out)
	}
	return out
}

// classifierPill is one classifier row's pill - its label (plus, for annotation_type, a color/hatch
// swatch preview), and (behind a <details> disclosure, no JS needed) an inline edit form for
// Title EN/ET + Sequence, with the color/hatch pair added on for annotation_type only. Sequence is
// what every <select> built from GetClassifiers/GetAllClassifiers orders by, so this is how an
// admin reorders any picklist in the app, not just annotation types.
templ classifierPill(classifierType ClassifierType, row Classifier, locale i18n.Locale) {
	{{ isAnnotation := classifierType == ClassifierAnnotationType }}
	{{ swatch := decodeAnnotationSwatch(row.Data) }}
	<span class={ "tag-pill", templ.KV("annotation-type-pill", isAnnotation) }>
		if isAnnotation {
			<span class="pattern-layer-swatch" style={ "background-color:" + swatch.Color }></span>
		}
		{ ClassifierLabel(row, locale) }
		<details class="annotation-type-edit">
			<summary aria-label="Edit">
				@web.Icon("edit", 10)
			</summary>
			<form method="post" action={ templ.URL("/settings/classifiers/" + string(classifierType) + "/" + row.ID + "/update") } class="annotation-type-edit-form">
				<input class="input classifier-edit-title" name="title" value={ row.Title } placeholder="Title (English)"/>
				<input class="input classifier-edit-title" name="titleEt" value={ row.TitleEt.String } placeholder="Title (Estonian)"/>
				<input class="input classifier-sequence-input" type="number" name="sequence" value={ strconv.Itoa(row.Sequence) } placeholder="Order"/>
				if isAnnotation {
					@annotationSwatchFields(swatch)
				}
				<button type="submit" class="btn btn-secondary" aria-label="Save" title="Save">
					@web.Icon("check_circle", 14)
				</button>
			</form>
		</details>
		<form method="post" action={ templ.URL("/settings/classifiers/" + string(classifierType) + "/" + row.ID + "/delete") } data-confirm={ "Remove \"" + row.Title + "\"?" }>
			<button type="submit" class="tag-pill-remove" aria-label="Remove">
				@web.Icon("close", 10)
			</button>
		</form>
	</span>
}

templ annotationSwatchFields(swatch annotationSwatch) {
	<input type="color" name="color" value={ swatch.Color } aria-label="Color" title="Color"/>
	<select name="hatch" class="input" aria-label="Pattern" title="Pattern">
		for _, opt := range hatchOptions {
			<option value={ opt.Value } selected?={ opt.Value == swatch.Hatch }>{ opt.Label }</option>
		}
	</select>
}
