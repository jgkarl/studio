package settings

import (
	"studio/internal/auth"
	"studio/internal/i18n"
	"studio/internal/theme"
	"studio/internal/web"
)

// IndexPage is the whole of Settings: one screen, no sub-navigation. Preferences (locale/theme —
// the same toggles the navbar exposes) at the top, one chip-group per classifier type Settings
// manages, and — admin only — the Users role table folded in below (see SettingsManagedTypes'
// doc comment for why that's here despite not being in the design artifact's 5 groups).
templ IndexPage(c web.Chrome, groups []ClassifierGroup, users []auth.User) {
	@web.AppLayout("Settings", c, indexBody(c, groups, users))
}

templ indexBody(c web.Chrome, groups []ClassifierGroup, users []auth.User) {
	@web.PageHeader("Settings", "Preferences and picklists used across the app.", templ.NopComponent)

	@web.Card() {
		<h2 class="dashboard-heading">Preferences</h2>
		<div class="row-actions">
			<form method="post" action="/locale/toggle">
				@web.Field("Language", currentLocaleName(c)) {
					<button type="submit" class="btn btn-secondary">Switch to { targetLocaleName(c) }</button>
				}
			</form>
			<form method="post" action="/theme/toggle">
				@web.Field("Theme", currentThemeName(c)) {
					<button type="submit" class="btn btn-secondary">Switch to { targetThemeName(c) }</button>
				}
			</form>
		</div>
	}

	for _, group := range groups {
		@classifierGroupCard(group)
	}

	if len(users) > 0 {
		@web.Card() {
			<h2 class="dashboard-heading">Users</h2>
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Name</th>
							<th>Email</th>
							<th>Status</th>
							<th>Role</th>
						</tr>
					</thead>
					<tbody>
						for _, u := range users {
							<tr>
								<td>{ u.Name }</td>
								<td>{ u.Email }</td>
								<td>
									if u.Provider.Valid && u.Provider.String == "email" {
										if u.EmailVerifiedAt.Valid {
											<span class="badge badge-green">Confirmed</span>
										} else {
											<span class="badge badge-amber">Awaiting confirmation</span>
										}
									} else {
										<span class="page-subtitle">n/a</span>
									}
								</td>
								<td>
									<form method="post" action={ templ.URL("/settings/users/" + u.ID + "/role") } class="row-actions">
										<select class="input" name="role" style="width: auto;">
											for _, role := range assignableRoles {
												<option value={ string(role) } selected?={ role == u.Role }>{ string(role) }</option>
											}
										</select>
										<button type="submit" class="btn btn-secondary">
											<img src="/static/icons/check-circle.svg" width="14" height="14" alt="" class="icon"/>
											Save
										</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ classifierGroupCard(group ClassifierGroup) {
	@web.Card() {
		<h2 class="dashboard-heading">{ group.Label }</h2>
		if len(group.Rows) == 0 {
			<p class="empty-state">No options yet.</p>
		}
		<div class="tag-pills">
			for _, row := range group.Rows {
				<span class="tag-pill">
					{ row.Title }
					<form method="post" action={ templ.URL("/settings/classifiers/" + string(group.Type) + "/" + row.ID + "/delete") } data-confirm={ "Remove \"" + row.Title + "\"?" }>
						<button type="submit" class="tag-pill-remove" aria-label="Remove">
							<img src="/static/icons/close.svg" width="10" height="10" alt="" class="icon"/>
						</button>
					</form>
				</span>
			}
		</div>
		<form method="post" action={ templ.URL("/settings/classifiers/" + string(group.Type)) } class="inline-edit-form">
			@web.Field("Add option", "") {
				<input class="input" name="title" required placeholder="New option name"/>
			}
			<button type="submit" class="btn btn-secondary">
				<img src="/static/icons/add.svg" width="14" height="14" alt="" class="icon"/>
				Add
			</button>
		</form>
	}
}

func currentLocaleName(c web.Chrome) string {
	if c.Locale == i18n.LocaleEN {
		return "Currently English"
	}
	return "Currently Eesti"
}

func targetLocaleName(c web.Chrome) string {
	if c.Locale == i18n.LocaleEN {
		return "Eesti"
	}
	return "English"
}

func currentThemeName(c web.Chrome) string {
	if c.Theme == theme.Dark {
		return "Currently dark"
	}
	return "Currently light"
}

func targetThemeName(c web.Chrome) string {
	if c.Theme == theme.Dark {
		return "light"
	}
	return "dark"
}
