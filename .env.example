# Copy to .env for local (non-Docker) runs, or edit directly on the VPS — see docs/deploy.md.

PORT=3000

# Filesystem path to the SQLite database file. The parent directory is created automatically if
# it doesn't exist. Back this up along with MEDIA_STORAGE_DIR below — together they're the whole
# app's state.
DB_PATH=./data/studio.db

# Signs session cookies and verification tokens — generate a real one for anything beyond a
# local throwaway: `openssl rand -hex 32`
AUTH_SECRET=dev-only-insecure-secret-change-me

# Set to false once real accounts matter — dev-login lets you sign in as any seeded user with no
# password.
ALLOW_DEV_LOGIN=true

# Absolute or relative path where uploaded media (originals + generated variants) is stored.
# Kept under the same data/ directory as DB_PATH on purpose — one directory to back up, and it
# matches deploy/studio.service's ReadWritePaths= (systemd hardening only grants write access to
# data/, not the whole checkout).
MEDIA_STORAGE_DIR=./data/media-storage

# Absolute origin used to build links in emails (verification, password reset). Falls back to the
# incoming request's Host header if unset.
APP_URL=

# SMTP — leave blank locally; unset SMTP_HOST logs email bodies to the server console instead of
# sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=studio@localhost
